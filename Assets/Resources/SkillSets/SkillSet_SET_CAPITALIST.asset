  id: SET_CAPITALIST
  displayName: "\u8CC7\u7523\u5BB6"
  displayNameEnglish: Capitalist
  displayNameChineseSimplified: "\u8D44\u672C\u5BB6"
  description: "\u5E02\u5834\u64CD\u4F5C\uFF1A\u30C4\u30E2\u5834\u306E4\u679A\u3092\u3059\u3079\u3066\u30E9\u30F3\u30C0\u30E0\u306A\u724C\u306B\u5909\u63DB\u3059\u308B\u3002\u307E\u305F\u3001\u521D\u671F\u72B6\u614B\u30673000Gold\u3092\u4FDD\u6301\u3057\u3001\u548C\u4E86\u306B\u3088\u3063\u3066\u5165\u624B\u3059\u308BGold\u304C\u5E38\u306B2\u500D\u3002"
  descriptionEnglish: 'Market Twist: Transforms all 4 tiles in the draw area into
    random tiles. Also starts the run with 3000 Gold, and Gold gained from winning
    is always doubled.'
  descriptionChineseSimplified: "\u63A7\u76D8: \u5C06\u6478\u724C\u533A\u76844\u5F20\u724C\u5168\u90E8\u53D8\u4E3A\u968F\u673A\u724C\u3002\u6B64\u5916\uFF0C\u521D\u59CB\u6301\u67093000Gold\uFF0C\u5E76\u4E14\u548C\u4E86\u83B7\u5F97\u7684Gold\u59CB\u7EC8\u53D8\u4E3A2\u500D\u3002"
  maxMP: 5000
