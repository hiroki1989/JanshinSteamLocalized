    devil:
      ja: "\u30B1\u30EB\u30D9\u30ED\u30B9"
      en: Cerberus
      zh: "\u523B\u8033\u67CF\u6D1B\u65AF"
    god:
      ja: "\u30CF\u30C7\u30B9"
      en: Hades
      zh: "\u54C8\u8FEA\u65AF"
    title:
      ja: "\u51A5\u5E9C\u306E\u4E09\u3064\u306E\u8A93\u3044"
      en: Three Oaths of the Underworld
      zh: "\u51A5\u5E9C\u4E09\u8A93"
    benefit:
      ja: "\u30D1\u30C3\u30B7\u30D6\u52B9\u679C2\u7CFB\u7D71\u4EE5\u4E0A\u3067\u548C\u4E86\u30C0\u30E1\u30FC\u30B8\uFF0B16.67\uFF05\u3002\u5404\u5C40\u958B\u59CB\u6642\u306B\u672A\u89E3\u653E\u30D1\u30C3\u30B7\u30D61\u3064\u3092\u30E9\u30F3\u30C0\u30E0\u3067\u4E00\u6642\u89E3\u653E"
      en: 'Two passive effect types: win damage +16.67%. Each hand temporarily unlocks one random locked passive.'
      zh: "\u89E6\u53D12\u79CD\u88AB\u52A8\u6548\u679C\uFF0C\u548C\u724C\u4F24\u5BB3+16.67%\u3002\u6BCF\u5C40\u5F00\u59CB\u968F\u673A\u4E34\u65F6\u89E3\u95011\u4E2A\u672A\u89E3\u9501\u88AB\u52A8\u3002"
    drawback:
      ja: "\u30D1\u30C3\u30B7\u30D6\u52B9\u679C0\uFF5E1\u7CFB\u7D71\u306E\u548C\u4E86\u30C0\u30E1\u30FC\u30B8\uFF0D20\uFF05"
      en: "Zero or one passive effect type: win damage \u221220%."
      zh: "\u4EC50\uFF5E1\u79CD\u88AB\u52A8\u6548\u679C\u7684\u548C\u724C\u4F24\u5BB3\u221220%\u3002"
    synergy:
      ja: "\u30C0\u30E1\u30FC\u30B8\u5F37\u5316\u30FBHP\u56DE\u5FA9\u30FBMP\u56DE\u5FA9\u306E\u5171\u9CF4"
      en: Damage / HP recovery / MP recovery synergy
      zh: "\u4F24\u5BB3\u5F3A\u5316\uFF0FHP\u6062\u590D\uFF0FMP\u6062\u590D\u5171\u9E23"
    emblem: "\u9580"
    accent: {r: 0.7, g: 0.39, b: 0.69, a: 1}
    mercy:
    - name:
        ja: "\u4EE3\u511F\u8EFD\u6E1B 1"
        en: Restraint 1
        zh: "\u51CF\u8F7B\u4EE3\u4EF7 1"
      description:
        ja: "\u30D1\u30C3\u30B7\u30D62\u7A2E\u985E\u672A\u6E80\u306E\u30C0\u30E1\u30FC\u30B8\u6E1B\u5C11 18%\n\u5C40\u958B\u59CB\u6642\u306EMP\u6E1B\u5C11 9%"
        en: 'Damage penalty below 2 passive types 18%

          MP lost at hand start: 9%'
        zh: "\u5C11\u4E8E2\u79CD\u88AB\u52A8\u7684\u4F24\u5BB3\u51CF\u5E45 18%\n\u6BCF\u5C40\u5F00\u59CB\u65F6MP\u51CF\u5C11 9%"
