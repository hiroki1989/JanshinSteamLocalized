        ja: "\u304A\u672D2\u7A2E\u985E\u306E\u6761\u4EF6\u6210\u7ACB\u3067\u30C0\u30E1\u30FC\u30B8 +65%\n\u5BFE\u8C61\u5F793\u7A2E\u985E\u4EE5\u4E0A\u306A\u3089\u3001\u3055\u3089\u306B\u30C0\u30E1\u30FC\u30B8\uFF0B25\uFF05\n2\u7A2E\u985E\u4EE5\u4E0A\u6210\u7ACB\u6642\u3001\u304A\u672D\u306E\u30C0\u30E1\u30FC\u30B8\u5897\u52A0\u90E8\u5206\u309220\uFF05\u5F37\u5316\u3002\u6700\u5927HP\uFF0D15\uFF05"
        en: "Match 2 ofuda conditions: damage +65%\nThree matching conditions add another +25% damage.\nWith two matches, ofuda damage bonus portion +20%; maximum HP \u221215%."
        zh: "\u6EE1\u8DB32\u79CD\u7B26\u5492\u6761\u4EF6\uFF1A\u4F24\u5BB3 +65%\n\u6EE1\u8DB33\u79CD\u6761\u4EF6\u65F6\uFF0C\u4F24\u5BB3\u518D+25%\u3002\n\u6EE1\u8DB32\u79CD\u6761\u4EF6\u65F6\uFF0C\u7B26\u5492\u4F24\u5BB3\u589E\u52A0\u90E8\u5206\u5F3A\u531620%\uFF1B\u6700\u5927HP\u221215%\u3002"
    resonance:
