  tutorialTitle: "\u5916\u4F1D\u30E2\u30FC\u30C9\u306E\u904A\u3073\u65B9"
  tutorialPages:
  - "\u30FB\u914D\u3089\u308C\u305F34\u679A\u304B\u3089\u3001\u624B\u724C13\u679A\u3092\u9078\u3073\u307E\u3059\u3002\n\u30FB\u6B8B\u308A\u306E21\u679A\u304C\u3001\u6368\u3066\u308B\u724C\u306E\u5019\u88DC\u306B\u306A\u308A\u307E\u3059\u3002\n\u30FB\u5F79\u306E\u3042\u308B\u30C6\u30F3\u30D1\u30A4\u3092\u4F5C\u308A\u3001\u300C\u30EA\u30FC\u30C1\u300D\u3067\u78BA\u5B9A\u3057\u307E\u3059\u3002\n\u30FB\u795E\u304B\u3089\u5148\u306B\u3001\u4EA4\u4E92\u306B1\u679A\u305A\u3064\u6368\u3066\u307E\u3059\u3002\n\u30FB\u81EA\u5206\u306E\u6700\u521D\u306E\u6253\u724C\u3067\u30EA\u30FC\u30C1\u304C\u304B\u304B\u308A\u307E\u3059\u3002"
  - "\u30FB\u30EA\u30FC\u30C1\u3068\u548C\u4E86\u306B\u306F\u3001\u6E80\u8CAB\u4EE5\u4E0A\u304C\u5FC5\u8981\u3067\u3059\u3002\n\u30FB\u30EA\u30FC\u30C1\u3068\u30C9\u30E9\u3092\u542B\u3081\u3066\u5224\u5B9A\u3057\u307E\u3059\u3002\u88CF\u30C9\u30E9\u3068\u304A\u672D\u306E\u500D\u7387\u306F\u542B\u3081\u307E\u305B\u3093\u3002\n\u30FB\u9AD8\u76EE\u3067\u6E80\u8CAB\u306B\u5C4A\u3051\u3070\u3001\u30EA\u30FC\u30C1\u3067\u304D\u307E\u3059\u3002\n\u30FB\u6E80\u8CAB\u306B\u5C4A\u304B\u306A\u3044\u5B89\u76EE\u304C\u51FA\u308B\u3068\u3001\u305D\u306E\u5C40\u306F\u9AD8\u76EE\u3067\u3082\u548C\u4E86\u3067\u304D\u306A\u304F\u306A\u308A\u307E\u3059\u3002\n\u30FB\u795E\u306F\u5E38\u306B\u89AA\u3001\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u5E38\u306B\u5B50\u3067\u3059\u3002"
  - "\u30FB\u548C\u4E86\u3067\u304D\u308B\u724C\u304C\u51FA\u305F\u3089\u300C\u30ED\u30F3\u300D\u3092\u9078\u3073\u307E\u3059\u3002\n\u30FB\u300C\u30B9\u30AD\u30C3\u30D7\u300D\u3059\u308B\u3068\u3001\u305D\u306E\u5C40\u306F\u30ED\u30F3\u3067\u304D\u306A\u304F\u306A\u308A\u307E\u3059\u3002\n\u30FB\u81EA\u5206\u306E\u6368\u3066\u724C\u306B\u5F85\u3061\u724C\u304C\u3042\u308B\u5834\u5408\u3082\u3001\u30ED\u30F3\u3067\u304D\u307E\u305B\u3093\u3002\n\u30FB17\u5DE1\u3067\u6D41\u5C40\u3067\u3059\u3002\u4E00\u65B9\u3060\u3051\u30EA\u30FC\u30C1\u3057\u3066\u3044\u308C\u3070\u3001\u305D\u306E\u8005\u304C1000\u70B9\u3092\u5F97\u307E\u3059\u3002\n\u30FB3\u5C40\u306E\u5408\u8A08\u70B9\u3067\u52DD\u8CA0\u3057\u307E\u3059\u3002\u540C\u70B9\u306F\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u6557\u5317\u3067\u3059\u3002"
  - "\u30FB2\u4EBA\u76EE\u306E\u795E\u304B\u3089\u300134\u679A\u306E\u4E2D\u306B\u300C\u6307\u5B9A\u724C\u300D\u304C\u793A\u3055\u308C\u307E\u3059\u3002\n\u30FB\u6307\u5B9A\u724C\u306F\u3001\u624B\u724C13\u679A\u306B\u5165\u308C\u308B\u3068\u6E1B\u70B9\u3092\u907F\u3051\u3089\u308C\u308B\u724C\u3067\u3059\u3002\n\u30FB\u5165\u308C\u306A\u304B\u3063\u305F\u6307\u5B9A\u724C1\u679A\u306B\u3064\u304D\u3001\u548C\u4E86\u6642\u306B1\u7FFB\u4E0B\u304C\u308A\u307E\u3059\u3002\n\u30FB\u30B9\u30AD\u30EB\u3067\u5225\u306E\u724C\u306B\u5909\u3048\u305F\u5834\u5408\u3082\u3001\u4F7F\u308F\u306A\u304B\u3063\u305F\u6271\u3044\u306B\u306A\u308A\u307E\u3059\u3002\n\u30FB\u6307\u5B9A\u724C\u306F2\u4EBA\u76EE\u30671\u679A\u30013\u4EBA\u76EE\u4EE5\u964D\u30672\u679A\u3067\u3059\u3002"
  - "\u30FB\u795E\u3068\u306E\u5BFE\u5C40\u524D\u306B\u3001\u304A\u672D\u30921\u679A\u9078\u3073\u307E\u3059\u3002\u8CC7\u7523\u5BB6\u306F2\u679A\u9078\u3079\u307E\u3059\u3002\n\u30FB\u304A\u672D\u306F3\u679A\u307E\u3067\u88C5\u5099\u3067\u304D\u3001\u5BFE\u5FDC\u3059\u308B\u5F79\u306E\u70B9\u6570\u3092\u5F37\u5316\u3057\u307E\u3059\u3002\n\u30FB\u88C5\u5099\u4E2D\u306E\u304A\u672D\u306F\u3001\u9078\u629E\u753B\u9762\u3067\u7834\u68C4\u3084\u5165\u308C\u66FF\u3048\u304C\u3067\u304D\u307E\u3059\u3002\n\u30FB\u795E\u306B\u52DD\u3064\u305F\u3073\u3001\u907A\u7269\u30921\u3064\u7372\u5F97\u3057\u307E\u3059\u3002\n\u30FB\u9014\u4E2D\u3067\u8CA0\u3051\u3066\u3082\u3001\u305D\u308C\u307E\u3067\u306B\u7372\u5F97\u3057\u305F\u5831\u916C\u306F\u6301\u3061\u5E30\u308C\u307E\u3059\u3002"
