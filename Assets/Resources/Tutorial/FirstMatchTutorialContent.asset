  m_Name: FirstMatchTutorialContent
  m_EditorClassIdentifier: Assembly-CSharp::FirstMatchTutorialContent
  pages:
  - editorLabel: "\u306F\u3058\u3081\u3066\u306E\u95D8\u3044"
    title:
      japanese: "\u306F\u3058\u3081\u3066\u306E\u95D8\u3044"
      english: Your first battle
      chineseSimplified: "\u521D\u6B21\u6218\u6597"
    body:
      japanese: "\u3088\u3046\u3053\u305D\u3001\u96C0\u795E -infinity-\u3078\u3002\n\u30B9\u30AD\u30EB\u3092\u4F7F\u3044\u3053\u306A\u3057\u3066\u624B\u3092\u4F5C\u3063\u3066\u795E\u3005\u3092\u5012\u3057\u307E\u3057\u3087\u3046\u3002\n\n\u307E\u305A\u306F\u753B\u9762\u306E\u898B\u65B9\u3068\u3001\u6700\u521D\u306E\u4E00\u624B\u307E\u3067\u306E\u6D41\u308C\u3092\u78BA\u8A8D\u3057\u307E\u3059\u3002"
      english: 'Welcome to Janshin -infinity-.

        Master your skills, build
        winning hands, and defeat the gods.


        First, let''s explore the screen
        and the steps leading to your first move.'
      chineseSimplified: "\u6B22\u8FCE\u6765\u5230\u300A\u96C0\u795E -infinity-\u300B\u3002\n\u719F\u7EC3\u8FD0\u7528\u6280\u80FD\uFF0C\u7EC4\u6210\u548C\u724C\u724C\u578B\uFF0C\u51FB\u8D25\u8BF8\u795E\u5427\u3002\n\n\u9996\u5148\uFF0C\u6765\u4E86\u89E3\u754C\u9762\u4EE5\u53CA\u5F00\u59CB\u7B2C\u4E00\u6B65\u64CD\u4F5C\u7684\u6D41\u7A0B\u3002"
    hint:
      japanese: 
      english: 
      chineseSimplified: 
    requiresEquippedSkill: 0
    compactBody: 0
    focusTargets: 
    exampleTiles: []
  - editorLabel: "\u548C\u4E86\u3057\u3066\u795E\u3005\u306B\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u3088\u3046"
    title:
      japanese: "\u548C\u4E86\u3057\u3066\u795E\u3005\u306B\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u3088\u3046"
      english: Win hands to damage the gods
      chineseSimplified: "\u548C\u724C\uFF0C\u5BF9\u8BF8\u795E\u9020\u6210\u4F24\u5BB3"
    body:
      japanese: "\u30D7\u30EC\u30A4\u30E4\u30FC\u304C\u548C\u4E86\u3059\u308B\u3068\u3001\u5F97\u70B9\u3084\u52B9\u679C\u306B\u5FDC\u3058\u3066\u795E\u3005\u306B\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u307E\u3059\u3002\u795E\u3005\u306EHP\u30920\u306B\u3059\u308C\u3070\u52DD\u5229\u3067\u3059\u3002\n\n\u795E\u3005\u306E\u548C\u4E86\u3067\u306F\u81EA\u5206\u304C\u30C0\u30E1\u30FC\u30B8\u3092\u53D7\u3051\u307E\u3059\u3002\u81EA\u5206\u306EHP\u3092\u5B88\u308A\u306A\u304C\u3089\u3001\u9AD8\u3044\u624B\u3092\u72D9\u3044\u307E\u3057\u3087\u3046\u3002"
      english: 'Winning a hand damages the gods based on your score and effects.
        Reduce their HP to 0 to win.


        When the gods win a hand, you take
        damage. Aim for valuable hands while protecting your HP.'
      chineseSimplified: "\u73A9\u5BB6\u548C\u724C\u65F6\uFF0C\u4F1A\u6839\u636E\u5F97\u5206\u53CA\u6548\u679C\u5BF9\u8BF8\u795E\u9020\u6210\u4F24\u5BB3\u3002\u5C06\u8BF8\u795E\u7684HP\u964D\u81F30\u5373\u53EF\u83B7\u80DC\u3002\n\n\u8BF8\u795E\u548C\u724C\u65F6\uFF0C\u4F60\u4F1A\u53D7\u5230\u4F24\u5BB3\u3002\u5728\u4FDD\u62A4\u81EA\u8EABHP\u7684\u540C\u65F6\uFF0C\u4E89\u53D6\u9AD8\u5206\u724C\u578B\u5427\u3002"
    hint:
      japanese: 
      english: 
      chineseSimplified: 
    requiresEquippedSkill: 0
    compactBody: 0
    focusTargets: 0000000001000000
    exampleTiles: []
  - editorLabel: "\u624B\u724C\u3068\u30C4\u30E2\u5834"
    title:
      japanese: "\u624B\u724C\u3068\u30C4\u30E2\u5834"
      english: Your hand and the draw area
      chineseSimplified: "\u624B\u724C\u4E0E\u6478\u724C\u533A"
    body:
      japanese: "\u624B\u724C\u306F\u3001\u548C\u4E86\u306E\u5F62\u3092\u4F5C\u308B\u305F\u3081\u306E\u724C\u3067\u3059\u3002\u6700\u521D\u306F13\u679A\u304B\u3089\u59CB\u307E\u308A\u307E\u3059\u3002\n\n\u81EA\u5206\u306E\u756A\u306B\u306A\u308B\u3068\u30C4\u30E2\u5834\u306B4\u679A\u306E\u724C\u304C\u51FA\u307E\u3059\u3002\u3053\u306E\u4E2D\u306E\u5FC5\u8981\u306A\u724C\u3068\u624B\u724C\u3092\u4EA4\u63DB\u3057\u3066\u3001\u624B\u3092\u6574\u3048\u307E\u3059\u3002"
      english: 'Your hand holds the tiles you use to build a winning hand. You start
        with 13 tiles.


        On your turn, four tiles appear in the draw area.
        Swap the ones you need with tiles in your hand.'
      chineseSimplified: "\u624B\u724C\u662F\u7528\u6765\u7EC4\u6210\u548C\u724C\u724C\u578B\u7684\u724C\u3002\u5F00\u59CB\u65F6\u670913\u5F20\u3002\n\n\u8F6E\u5230\u4F60\u65F6\uFF0C\u6478\u724C\u533A\u4F1A\u51FA\u73B04\u5F20\u724C\u3002\u5C06\u5176\u4E2D\u9700\u8981\u7684\u724C\u4E0E\u624B\u724C\u4EA4\u6362\uFF0C\u6574\u7406\u724C\u578B\u3002"
    hint:
      japanese: 
      english: 
      chineseSimplified: 
    requiresEquippedSkill: 0
    compactBody: 0
    focusTargets: 0200000003000000
    exampleTiles: []
  - editorLabel: "\u4EA4\u63DB\u3057\u3066\u304B\u3089\u300C\u6368\u3066\u308B\u300D"
    title:
      japanese: "\u4EA4\u63DB\u3057\u3066\u304B\u3089\u300C\u6368\u3066\u308B\u300D"
      english: Swap, then Discard
      chineseSimplified: "\u4EA4\u6362\u540E\u70B9\u51FB\u201C\u820D\u724C\u201D"
    body:
      japanese: "\u30C4\u30E2\u5834\u306E\u6B32\u3057\u3044\u724C\u3092\u3001\u624B\u724C\u306E\u4EA4\u63DB\u3057\u305F\u3044\u724C\u3078\u30C9\u30E9\u30C3\u30B0\u3057\u307E\u3059\u3002\n\n\u624B\u304C\u6574\u3063\u305F\u3089\u300C\u6368\u3066\u308B\u300D\u3067\u30C4\u30E2\u5834\u306B\u6B8B\u3063\u305F\u724C\u3092\u6368\u3066\u3001\u795E\u3005\u306E\u756A\u3078\u9032\u307F\u307E\u3059\u3002\u4EA4\u63DB\u305B\u305A\u306B\u9032\u3080\u3053\u3068\u3082\u3067\u304D\u307E\u3059\u3002"
      english: 'Drag a tile you want from the draw area onto the tile you want to
        replace in your hand.


        When ready, press Discard to discard the
        tiles left in the draw area and end your turn. You can also continue without
        swapping.'
      chineseSimplified: "\u5C06\u6478\u724C\u533A\u4E2D\u60F3\u8981\u7684\u724C\uFF0C\u62D6\u5230\u624B\u724C\u4E2D\u60F3\u66FF\u6362\u7684\u724C\u4E0A\u3002\n\n\u6574\u7406\u597D\u540E\uFF0C\u70B9\u51FB\u201C\u820D\u724C\u201D\uFF0C\u5F03\u6389\u6478\u724C\u533A\u5269\u4F59\u7684\u724C\uFF0C\u8FDB\u5165\u8BF8\u795E\u7684\u56DE\u5408\u3002\u4E5F\u53EF\u4EE5\u4E0D\u4EA4\u6362\u76F4\u63A5\u7EE7\u7EED\u3002"
    hint:
      japanese: "\u300C\u6368\u3066\u308B\u300D\u3092\u62BC\u3059\u524D\u306B\u3001\u624B\u724C\u3068\u6B8B\u3063\u305F\u724C\u3092\u78BA\u8A8D\u3057\u307E\u3057\u3087\u3046\u3002"
      english: Before pressing Discard, check your hand and the remaining tiles.
      chineseSimplified: "\u70B9\u51FB\u201C\u820D\u724C\u201D\u524D\uFF0C\u8BF7\u786E\u8BA4\u624B\u724C\u548C\u5269\u4F59\u7684\u724C\u3002"
    requiresEquippedSkill: 0
    compactBody: 0
    focusTargets: 0300000002000000
    exampleTiles: []
  - editorLabel: "\u548C\u4E86\u306E\u57FA\u672C\u5F62"
    title:
      japanese: "\u548C\u4E86\u306E\u57FA\u672C\u5F62"
      english: The basic winning shape
      chineseSimplified: "\u548C\u724C\u7684\u57FA\u672C\u724C\u578B"
    body:
      japanese: "\u57FA\u672C\u306F\u300C3\u679A\u306E\u7D44\u30924\u3064 \uFF0B
        \u540C\u3058\u724C2\u679A\u306E\u30DA\u30A2\u300D\u3067\u3059\u3002\n3\u679A\u306E\u7D44\u306F\u3001\u540C\u3058\u7A2E\u985E\u306E\u9023\u756A\uFF08\u4F8B\uFF1A\u4E8C\u30FB\u4E09\u30FB\u56DB\u842C\uFF09\u304B\u3001\u540C\u3058\u724C3\u679A\u3067\u4F5C\u308A\u307E\u3059\u3002\n\n\u3055\u3089\u306B\u300C\u5F79\u300D\u304C\u5FC5\u8981\u3067\u3059\u3002\u305F\u3068\u3048\u3070\u30BF\u30F3\u30E4\u30AA\u306F\u30011\u30FB9\u3068\u5B57\u724C\u3092\u4F7F\u308F\u306A\u3044\u624B\u3067\u3059\u3002"
      english: 'The basic shape is four sets of three tiles plus a pair.

        A
        set is a sequence in one suit (e.g. 2, 3, 4 of characters) or three identical
        tiles.


        You also need a yaku. For example, Tanyao is a hand with
        no 1s, 9s, or honor tiles.'
      chineseSimplified: "\u57FA\u672C\u724C\u578B\u662F\u201C4\u7EC4\u54043\u5F20\u7684\u9762\u5B50\uFF0B1\u5BF9\u76F8\u540C\u724C\u201D\u3002\n\u9762\u5B50\u53EF\u4EE5\u662F\u540C\u4E00\u82B1\u8272\u7684\u8FDE\u7EED\u6570\u5B57\uFF08\u5982\u4E8C\u3001\u4E09\u3001\u56DB\u4E07\uFF09\uFF0C\u62163\u5F20\u76F8\u540C\u7684\u724C\u3002\n\n\u6B64\u5916\u8FD8\u9700\u8981\u201C\u5F79\u201D\u3002\u4F8B\u5982\u65AD\u5E7A\u4E5D\uFF0C\u5C31\u662F\u4E0D\u4F7F\u7528\u4E00\u3001\u4E5D\u53CA\u5B57\u724C\u7684\u724C\u578B\u3002"
    hint:
      japanese: "\u4F8B\uFF1A\u30BF\u30F3\u30E4\u30AA\u306E\u5F62\u3002\u4E03\u5BFE\u5B50\u306A\u3069\u3001\u5225\u306E\u548C\u4E86\u5F62\u3082\u3042\u308A\u307E\u3059\u3002"
      english: 'Example: a Tanyao hand. Other winning shapes include Seven Pairs.'
      chineseSimplified: "\u4F8B\uFF1A\u65AD\u5E7A\u4E5D\u724C\u578B\u3002\u6B64\u5916\u8FD8\u6709\u4E03\u5BF9\u5B50\u7B49\u5176\u4ED6\u548C\u724C\u724C\u578B\u3002"
    requiresEquippedSkill: 0
    compactBody: 0
    focusTargets: 
    exampleTiles:
    - Man2
    - Man3
    - Man4
    - Pin3
    - Pin4
    - Pin5
    - Sou4
    - Sou5
    - Sou6
    - Man6
    - Man6
    - Man6
    - Pin8
    - Pin8
  - editorLabel: "\u30C6\u30F3\u30D1\u30A4\u30FB\u30EA\u30FC\u30C1\u30FB\u548C\u4E86"
    title:
      japanese: "\u30C6\u30F3\u30D1\u30A4\u30FB\u30EA\u30FC\u30C1\u30FB\u548C\u4E86"
      english: Tenpai, Riichi & winning
      chineseSimplified: "\u542C\u724C\u3001\u7ACB\u76F4\u4E0E\u548C\u724C"
    body:
      japanese: "\u3042\u30681\u679A\u3067\u548C\u4E86\u3067\u304D\u308B\u72B6\u614B\u304C\u300C\u30C6\u30F3\u30D1\u30A4\u300D\u3067\u3059\u3002\u6761\u4EF6\u3092\u6E80\u305F\u3059\u3068\u30EA\u30FC\u30C1\u3067\u304D\u307E\u3059\u304C\u3001\u5BA3\u8A00\u5F8C\u306F\u624B\u3092\u81EA\u7531\u306B\u5909\u3048\u3089\u308C\u307E\u305B\u3093\u3002\u3088\u308A\u826F\u3044\u624B\u3092\u76EE\u6307\u3057\u3066\u3001\u30C6\u30F3\u30D1\u30A4\u3057\u3066\u3082\u30EA\u30FC\u30C1\u3092\u304B\u3051\u306A\u3044\u3053\u3068\u3082\u3042\u308B\u3067\u3057\u3087\u3046\u3002\n\n\u81EA\u5206\u306E\u30C4\u30E2\u724C\u3067\u5B8C\u6210\u3059\u308C\u3070\u30C4\u30E2\u3001\u795E\u3005\u306E\u6368\u3066\u724C\u3067\u5B8C\u6210\u3059\u308C\u3070\u30ED\u30F3\u3067\u3059\u3002\u548C\u4E86\u3067\u304D\u308B\u3068\u304D\u306F\u3001\u753B\u9762\u306B\u51FA\u308B\u548C\u4E86\u30DC\u30BF\u30F3\u3092\u78BA\u8A8D\u3057\u307E\u3057\u3087\u3046\u3002"
      english: 'Tenpai means you need one more tile to win. You can declare Riichi
        when eligible, but cannot freely change your hand afterward. You may stay
        in Tenpai without declaring Riichi to aim for a better hand.


        Complete
        your hand with a drawn tile for Tsumo, or a god''s discard for Ron. Watch
        for the win button when you can win.'
      chineseSimplified: "\u53EA\u5DEE1\u5F20\u724C\u5373\u53EF\u548C\u724C\u7684\u72B6\u6001\u79F0\u4E3A\u201C\u542C\u724C\u201D\u3002\u6EE1\u8DB3\u6761\u4EF6\u5373\u53EF\u7ACB\u76F4\uFF0C\u4F46\u5BA3\u544A\u540E\u4FBF\u4E0D\u80FD\u81EA\u7531\u6539\u53D8\u624B\u724C\u3002\u4E3A\u4E86\u8FFD\u6C42\u66F4\u597D\u7684\u724C\u578B\uFF0C\u4E5F\u53EF\u4EE5\u542C\u724C\u540E\u4E0D\u7ACB\u76F4\u3002\n\n\u7528\u81EA\u5DF1\u6478\u5230\u7684\u724C\u5B8C\u6210\u724C\u578B\u79F0\u4E3A\u81EA\u6478\uFF0C\u7528\u8BF8\u795E\u7684\u820D\u724C\u5B8C\u6210\u5219\u79F0\u4E3A\u8363\u548C\u3002\u53EF\u4EE5\u548C\u724C\u65F6\uFF0C\u8BF7\u7559\u610F\u753B\u9762\u4E0A\u7684\u548C\u724C\u6309\u94AE\u3002"
    hint:
      japanese: "\u30C9\u30E9\u306F\u5F97\u70B9\u3092\u5897\u3084\u3059\u724C\u3067\u3059\u304C\u3001\u30C9\u30E9\u3060\u3051\u3067\u306F\u5F79\u306B\u306A\u308A\u307E\u305B\u3093\u3002"
      english: Dora increase your score, but Dora alone do not count as a yaku.
      chineseSimplified: "\u5B9D\u724C\u53EF\u4EE5\u589E\u52A0\u5F97\u5206\uFF0C\u4F46\u4EC5\u6709\u5B9D\u724C\u4E0D\u6784\u6210\u5F79\u3002"
    requiresEquippedSkill: 0
    compactBody: 0
    focusTargets: 04000000
    exampleTiles: []
  - editorLabel: "\u6575\u306E\u6368\u3066\u724C\u3068\u9CF4\u304D"
    title:
      japanese: "\u6575\u306E\u6368\u3066\u724C\u3068\u9CF4\u304D"
      english: Enemy discards & calls
      chineseSimplified: "\u654C\u65B9\u820D\u724C\u4E0E\u9E23\u724C"
    body:
      japanese: "\u6575\u306E\u6368\u3066\u724C\u306F\u3001\u30ED\u30F3\u3084\u9CF4\u304D\u306E\u5224\u65AD\u306B\u4F7F\u3044\u307E\u3059\u3002\u6761\u4EF6\u304C\u5408\u3048\u3070\u3001\u30C1\u30FC\u30FB\u30DD\u30F3\u30FB\u30AB\u30F3\u3067\u724C\u3092\u53D6\u308A\u8FBC\u3081\u307E\u3059\u3002\n\n\u9CF4\u304F\u3068\u4F5C\u308C\u306A\u304F\u306A\u308B\u5F79\u3082\u3042\u308A\u3001\u30EA\u30FC\u30C1\u3082\u304B\u3051\u3089\u308C\u306A\u304F\u306A\u308B\u305F\u3081\u3001\u6700\u521D\u306F\u7121\u7406\u306B\u9CF4\u304B\u305A\u3001\u4E0D\u8981\u306A\u3068\u304D\u306F\u300C\u30B9\u30AD\u30C3\u30D7\u300D\u3067\u9032\u3081\u307E\u3057\u3087\u3046\u3002"
      english: 'Check enemy discards for Ron or a call. When eligible, you can claim
        tiles with Chi, Pon, or Kan.


        Calling prevents some yaku and stops
        you from declaring Riichi. You needn''t force a call as a beginner; choose
        Skip when you don''t need the tile.'
      chineseSimplified: "\u67E5\u770B\u654C\u65B9\u820D\u724C\uFF0C\u5224\u65AD\u80FD\u5426\u8363\u548C\u6216\u9E23\u724C\u3002\u6EE1\u8DB3\u6761\u4EF6\u65F6\uFF0C\u53EF\u4EE5\u901A\u8FC7\u5403\u3001\u78B0\u3001\u6760\u53D6\u5F97\u724C\u3002\n\n\u9E23\u724C\u540E\u6709\u4E9B\u5F79\u65E0\u6CD5\u6210\u7ACB\uFF0C\u4E5F\u65E0\u6CD5\u7ACB\u76F4\u3002\u521A\u5F00\u59CB\u4E0D\u5FC5\u52C9\u5F3A\u9E23\u724C\uFF0C\u4E0D\u9700\u8981\u65F6\u70B9\u51FB\u201C\u8DF3\u8FC7\u201D\u5373\u53EF\u3002"
    hint:
      japanese: "\u81EA\u5206\u304C\u4E00\u5EA6\u6368\u3066\u305F\u724C\u3067\u3082\u795E\u3005\u304B\u3089\u30ED\u30F3\u3067\u304D\u308B\u3002\u6C17\u306B\u305B\u305A\u30D5\u30EA\u30C6\u30F3\u30EA\u30FC\u30C1\u3092\u304B\u3051\u3088\u3046\u3002"
      english: You can Ron a god's discard even if you previously discarded that
        tile. Feel free to declare Riichi in Furiten.
      chineseSimplified: "\u5373\u4F7F\u81EA\u5DF1\u66FE\u820D\u51FA\u8FC7\u8FD9\u5F20\u724C\uFF0C\u4E5F\u80FD\u8363\u548C\u8BF8\u795E\u7684\u820D\u724C\u3002\u653E\u5FC3\u632F\u542C\u7ACB\u76F4\u5427\u3002"
    requiresEquippedSkill: 0
    compactBody: 0
    focusTargets: 05000000
    exampleTiles: []
  - editorLabel: "\u30B9\u30AD\u30EB\u3068MP"
    title:
      japanese: "\u30B9\u30AD\u30EB\u3068MP"
      english: Skills & MP
      chineseSimplified: "\u6280\u80FD\u4E0EMP"
    body:
      japanese: "\u30B9\u30AD\u30EB\u306F\u3001MP\u3092\u6D88\u8CBB\u3059\u308B\u3053\u3068\u3067\u3001\u724C\u3092\u5909\u63DB\u306A\u3069\u3057\u3066\u624B\u4F5C\u308A\u3092\u52A9\u3051\u307E\u3059\u3002\u67D3\u8272\u5E2B\u306E\u30B9\u30AD\u30EB\u300C\u8272\u5BC4\u305B\u300D\u306F\u3001\u5BFE\u8C61\u306E\u724C\u3092\u9078\u3073\u300C\u30B9\u30AD\u30EB\u300D\u3067\u767A\u52D5\u3059\u308B\u3068\u3001\u624B\u724C\u306E\u4E2D\u3067\u4E00\u756A\u591A\u3044\u8272\u306E\u30E9\u30F3\u30C0\u30E0\u306A\u724C\u306B\u5909\u63DB\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\u30DB\u30F3\u30A4\u30C4\u3084\u30C1\u30F3\u30A4\u30C4\u3092\u72D9\u3063\u305F\u308A\u3001\u4E0D\u8981\u306A\u724C\u3092\u6709\u52B9\u306A\u724C\u306B\u5909\u3048\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\n\nMP\u304C\u4E0D\u8DB3\u3057\u3066\u3044\u308B\u3068\u30B9\u30AD\u30EB\u306F\u4F7F\u3048\u307E\u305B\u3093\u3002"
      english: 'Skills spend MP to help build your hand, for example by converting
        tiles. The Dyer''s Chromaflow converts a selected tile into a random tile
        of the most common suit in your hand when you press Skill. Use it to aim
        for a half flush or full flush, or to turn an unwanted tile into a useful
        one.


        You cannot use a skill without enough MP.'
      chineseSimplified: "\u6280\u80FD\u901A\u8FC7\u6D88\u8017MP\u6765\u53D8\u6362\u724C\u7B49\uFF0C\u5E2E\u52A9\u6574\u7406\u624B\u724C\u3002\u67D3\u8272\u5E08\u7684\u201C\u5F15\u8272\u201D\u6280\u80FD\uFF1A\u9009\u62E9\u76EE\u6807\u724C\u5E76\u70B9\u51FB\u201C\u6280\u80FD\u201D\u540E\uFF0C\u53EF\u5C06\u5176\u53D8\u4E3A\u624B\u724C\u4E2D\u6570\u91CF\u6700\u591A\u7684\u82B1\u8272\u7684\u968F\u673A\u724C\u3002\u53EF\u7528\u6765\u8FFD\u6C42\u6DF7\u4E00\u8272\u3001\u6E05\u4E00\u8272\uFF0C\u6216\u5C06\u4E0D\u9700\u8981\u7684\u724C\u53D8\u4E3A\u6709\u7528\u7684\u724C\u3002\n\nMP\u4E0D\u8DB3\u65F6\u65E0\u6CD5\u4F7F\u7528\u6280\u80FD\u3002"
    hint:
      japanese: 
      english: 
      chineseSimplified: 
    requiresEquippedSkill: 0
    compactBody: 0
    focusTargets: 0700000008000000
    exampleTiles: []
  - editorLabel: "\u30D1\u30C3\u30B7\u30D6\u30B9\u30AD\u30EB"
    title:
      japanese: "\u30D1\u30C3\u30B7\u30D6\u30B9\u30AD\u30EB"
      english: Passive skills
      chineseSimplified: "\u88AB\u52A8\u6280\u80FD"
    body:
      japanese: "\u5BFE\u5FDC\u3059\u308B\u5F79\u3092\u548C\u4E86\u3059\u308B\u3068\u52B9\u679C\u3092\u767A\u63EE\u3059\u308B\u30B9\u30AD\u30EB\u3067\u3059\u3002\u5BFE\u5FDC\u3059\u308B\u5F79\u306F\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u3054\u3068\u306B\u7570\u306A\u308A\u307E\u3059\u3002\u6700\u521D\u306F\u4E00\u90E8\u306E\u5F79\u3057\u304B\u89E3\u653E\u3055\u308C\u3066\u3044\u307E\u305B\u3093\u304C\u3001Gold\u3092\u6D88\u8CBB\u3057\u3066\u8FFD\u52A0\u3057\u305F\u308A\u30EC\u30D9\u30EB\u3092\u4E0A\u3052\u305F\u308A\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\u7279\u5225\u724C\u3092\u5165\u624B\u3057\u3066\u88C5\u5099\u3059\u308B\u3053\u3068\u3067\u3082\u30D1\u30C3\u30B7\u30D6\u30B9\u30AD\u30EB\u3092\u5F37\u5316\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3002\n\n<sprite=0>
        \uFF1A\u5BFE\u5FDC\u3059\u308B\u5F79\u3067\u548C\u4E86\u3059\u308B\u3068\u3001\u6575\u3078\u306E\u30C0\u30E1\u30FC\u30B8\u304C\u4E00\u5B9A\u306E\u5272\u5408\u3067\u52A0\u7B97\u3055\u308C\u307E\u3059\u3002\n<sprite=1>
        \uFF1A\u5BFE\u5FDC\u3059\u308B\u5F79\u3067\u548C\u4E86\u3059\u308B\u3068\u3001\u57FA\u790E\u70B9\u306E\u4E00\u5B9A\u5272\u5408\u306EHP\u304C\u56DE\u5FA9\u3057\u307E\u3059\u3002\n<sprite=2>
        \uFF1A\u5BFE\u5FDC\u3059\u308B\u5F79\u3067\u548C\u4E86\u3059\u308B\u3068\u3001\u57FA\u790E\u70B9\u306E\u4E00\u5B9A\u5272\u5408\u306EMP\u304C\u56DE\u5FA9\u3057\u307E\u3059\u3002"
      english: 'Passives activate when you win with a matching yaku. Each character
        has different yaku. Only some are unlocked at first; spend Gold to add or
        level them up. Equipping special tiles also strengthens passives.


        <sprite=0>
        : A matching win adds a percentage damage bonus.

        <sprite=1> : A
        matching win restores HP equal to a percentage of the base score.

        <sprite=2>
        : A matching win restores MP equal to a percentage of the base score.'
      chineseSimplified: "\u4EE5\u5BF9\u5E94\u7684\u5F79\u548C\u724C\u65F6\uFF0C\u88AB\u52A8\u6280\u80FD\u5C31\u4F1A\u751F\u6548\u3002\u5BF9\u5E94\u7684\u5F79\u56E0\u89D2\u8272\u800C\u5F02\u3002\u8D77\u521D\u53EA\u89E3\u9501\u90E8\u5206\u5F79\uFF0C\u53EF\u6D88\u8017Gold\u8FFD\u52A0\u6216\u5347\u7EA7\u3002\u83B7\u5F97\u5E76\u88C5\u5907\u7279\u6B8A\u724C\u4E5F\u80FD\u5F3A\u5316\u88AB\u52A8\u6280\u80FD\u3002\n\n<sprite=0>
        \uFF1A\u4EE5\u5BF9\u5E94\u7684\u5F79\u548C\u724C\u65F6\uFF0C\u6309\u4E00\u5B9A\u6BD4\u4F8B\u589E\u52A0\u5BF9\u654C\u4F24\u5BB3\u3002\n<sprite=1>
        \uFF1A\u4EE5\u5BF9\u5E94\u7684\u5F79\u548C\u724C\u65F6\uFF0C\u56DE\u590D\u76F8\u5F53\u4E8E\u57FA\u7840\u70B9\u6570\u4E00\u5B9A\u6BD4\u4F8B\u7684HP\u3002\n<sprite=2>
        \uFF1A\u4EE5\u5BF9\u5E94\u7684\u5F79\u548C\u724C\u65F6\uFF0C\u56DE\u590D\u76F8\u5F53\u4E8E\u57FA\u7840\u70B9\u6570\u4E00\u5B9A\u6BD4\u4F8B\u7684MP\u3002"
    hint:
      japanese: "\u795E\u3005\u306B\u5927\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u305F\u3044\u3068\u304D\u3001\u81EA\u5206\u306EHP\u304C\u6B8B\u308A\u308F\u305A\u304B\u306A\u3068\u304D\u3001\u306A\u3069\u5834\u9762\u306B\u5FDC\u3058\u3066\u81E8\u6A5F\u5FDC\u5909\u306B\u72D9\u3046\u5F79\u3092\u5909\u3048\u3066\u3044\u3053\u3046\u3002"
      english: Adapt your target yaku to the situation, whether you need heavy damage
        against the gods or your HP is running low.
      chineseSimplified: "\u60F3\u5BF9\u8BF8\u795E\u9020\u6210\u5927\u91CF\u4F24\u5BB3\u65F6\uFF0C\u6216\u81EA\u8EABHP\u6240\u5269\u65E0\u51E0\u65F6\uFF0C\u7075\u6D3B\u8C03\u6574\u76EE\u6807\u5F79\u5427\u3002"
    requiresEquippedSkill: 0
    compactBody: 1
    focusTargets: 0a000000
    exampleTiles: []
  - editorLabel: "\u304A\u5B88\u308A"
    title:
      japanese: "\u304A\u5B88\u308A"
      english: Omamori
      chineseSimplified: "\u5FA1\u5B88"
    body:
      japanese: "\u304A\u5B88\u308A\u306F\u3001\u88C5\u5099\u3059\u308B\u3053\u3068\u3067\u80FD\u529B\u3092\u5F37\u5316\u3059\u308B\u30A2\u30A4\u30C6\u30E0\u3067\u3059\u3002\u6700\u5927HP\u306E\u5897\u52A0\u3084\u88AB\u30C0\u30E1\u30FC\u30B8\u306E\u8EFD\u6E1B\u306A\u3069\u3001\u304A\u5B88\u308A\u3054\u3068\u306B\u7570\u306A\u308B\u52B9\u679C\u304C\u3042\u308A\u307E\u3059\u3002\n\n\u795E\u3005\u3092\u5012\u3057\u3066\u5831\u916C\u306E\u304A\u5B88\u308A\u3092\u624B\u306B\u5165\u308C\u305F\u3089\u3001\u88C5\u5099\u753B\u9762\u3067\u52B9\u679C\u3092\u78BA\u8A8D\u3057\u3066\u88C5\u5099\u3057\u307E\u3057\u3087\u3046\u3002\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u3084\u72D9\u3046\u5F79\u306B\u5408\u3063\u305F\u7D44\u307F\u5408\u308F\u305B\u3092\u9078\u3076\u3053\u3068\u304C\u5927\u5207\u3067\u3059\u3002"
      english: 'Omamori are items that strengthen you when equipped. Each has its
        own effects, such as increasing maximum HP or reducing incoming damage.


        After
        defeating the gods and earning an Omamori, check its effects and equip it
        on the equipment screen. Choose a combination that suits your character and
        target yaku.'
      chineseSimplified: "\u5FA1\u5B88\u662F\u88C5\u5907\u540E\u53EF\u5F3A\u5316\u80FD\u529B\u7684\u9053\u5177\u3002\u4E0D\u540C\u5FA1\u5B88\u6709\u4E0D\u540C\u6548\u679C\uFF0C\u4F8B\u5982\u63D0\u5347HP\u4E0A\u9650\u6216\u51CF\u5C11\u6240\u53D7\u4F24\u5BB3\u3002\n\n\u51FB\u8D25\u8BF8\u795E\u5E76\u83B7\u5F97\u5FA1\u5B88\u5956\u52B1\u540E\uFF0C\u5728\u88C5\u5907\u754C\u9762\u786E\u8BA4\u6548\u679C\u5E76\u88C5\u5907\u3002\u9009\u62E9\u9002\u5408\u89D2\u8272\u53CA\u76EE\u6807\u5F79\u7684\u7EC4\u5408\u5427\u3002"
    hint:
      japanese: "\u6301\u3063\u3066\u3044\u308B\u3060\u3051\u3067\u306F\u52B9\u679C\u306F\u767A\u63EE\u3055\u308C\u307E\u305B\u3093\u3002\u5BFE\u5C40\u524D\u306B\u88C5\u5099\u3092\u78BA\u8A8D\u3057\u307E\u3057\u3087\u3046\u3002"
      english: Owning an Omamori is not enough. Check your equipment before the match.
      chineseSimplified: "\u4EC5\u6301\u6709\u5FA1\u5B88\u4E0D\u4F1A\u751F\u6548\u3002\u5BF9\u5C40\u524D\u8BF7\u786E\u8BA4\u88C5\u5907\u3002"
    requiresEquippedSkill: 0
    compactBody: 0
    focusTargets: 0b000000
    exampleTiles: []
  - editorLabel: "\u304A\u672D"
    title:
      japanese: "\u304A\u672D"
      english: Ofuda
      chineseSimplified: "\u7B26\u672D"
    body:
      japanese: "\u304A\u672D\u306F\u3001\u6311\u6226\u4E2D\u306B\u624B\u306B\u5165\u308B\u5F37\u5316\u30A2\u30A4\u30C6\u30E0\u3067\u3059\u3002\u5BFE\u5C40\u306E\u5408\u9593\u306E\u5F37\u5316\u753B\u9762\u3067\u8CFC\u5165\u3067\u304D\u3001\u548C\u4E86\u6642\u306E\u30C0\u30E1\u30FC\u30B8\u3084HP\u30FBMP\u306E\u56DE\u5FA9\u306A\u3069\u3092\u52A9\u3051\u307E\u3059\u3002\n\n\u6301\u3066\u308B\u304A\u672D\u306F\u6700\u59273\u679A\u3067\u3059\u3002\u6240\u6301\u67A0\u3068\u52B9\u679C\u3092\u78BA\u8A8D\u3057\u3001\u4ECA\u306E\u624B\u4F5C\u308A\u3084\u6226\u3044\u65B9\u306B\u5408\u3046\u3082\u306E\u3092\u9078\u3073\u307E\u3057\u3087\u3046\u3002\u304A\u672D\u306E\u52B9\u679C\u306F\u305D\u306E\u6311\u6226\u4E2D\u306E\u307F\u6709\u52B9\u3067\u3059\u3002"
      english: 'Ofuda are upgrades obtained during a run. Buy them on the upgrade
        screen between matches to help with damage or HP and MP recovery when you
        win.


        You can hold up to three Ofuda. Check your slots and their
        effects, then choose ones that suit your hands and strategy. Their effects
        last for the current run.'
      chineseSimplified: "\u7B26\u672D\u662F\u5728\u6311\u6218\u9014\u4E2D\u83B7\u5F97\u7684\u5F3A\u5316\u9053\u5177\u3002\u53EF\u5728\u5BF9\u5C40\u4E4B\u95F4\u7684\u5F3A\u5316\u754C\u9762\u8D2D\u4E70\uFF0C\u5E2E\u52A9\u63D0\u5347\u548C\u724C\u4F24\u5BB3\u6216\u56DE\u590DHP\u3001MP\u7B49\u3002\n\n\u6700\u591A\u53EF\u6301\u67093\u5F20\u7B26\u672D\u3002\u786E\u8BA4\u6301\u6709\u680F\u4F4D\u53CA\u6548\u679C\uFF0C\u9009\u62E9\u9002\u5408\u5F53\u524D\u724C\u578B\u4E0E\u6218\u672F\u7684\u7B26\u672D\u3002\u6548\u679C\u5728\u672C\u6B21\u6311\u6218\u4E2D\u6709\u6548\u3002"
    hint:
      japanese: 
      english: Check your Ofuda on the match screen, and consider how they work with
        your Omamori and skills.
      chineseSimplified: "\u53EF\u5728\u5BF9\u5C40\u754C\u9762\u67E5\u770B\u6301\u6709\u7684\u7B26\u672D\uFF0C\u4E5F\u8981\u8003\u8651\u4E0E\u5FA1\u5B88\u3001\u6280\u80FD\u7684\u642D\u914D\u3002"
    requiresEquippedSkill: 0
    compactBody: 0
    focusTargets: 0c000000
    exampleTiles: []
  - editorLabel: "\u5BFE\u5C40\u3092\u59CB\u3081\u3088\u3046"
    title:
      japanese: "\u3055\u3042\u5BFE\u5C40\u3092\u59CB\u3081\u3088\u3046"
      english: Let's start the match
      chineseSimplified: "\u5F00\u59CB\u5BF9\u5C40\u5427"
    body:
      japanese: "1. \u6575\u306E\u6368\u3066\u724C\u3092\u898B\u3066\u3001\u5FC5\u8981\u304C\u306A\u3051\u308C\u3070\u30B9\u30AD\u30C3\u30D7\u3002\n2.
        \u81EA\u5206\u306E\u756A\u3067\u30C4\u30E2\u5834\u3068\u624B\u724C\u3092\u4EA4\u63DB\u3002\n3.
        \u30B9\u30AD\u30EB\u3084\u548C\u4E86\u306E\u30C1\u30E3\u30F3\u30B9\u3092\u78BA\u8A8D\u3057\u3066\u300C\u6368\u3066\u308B\u300D\u3002\n\n\u307E\u305A\u306F\u540C\u3058\u724C\u3084\u9023\u756A\u3092\u96C6\u3081\u3001\u548C\u4E86\u3092\u76EE\u6307\u3057\u307E\u3057\u3087\u3046\u3002"
      english: '1. Check enemy discards; Skip if you need none.

        2. On your
        turn, swap tiles between the draw area and your hand.

        3. Check for
        skills and winning chances, then press Discard.


        Start by collecting
        matching tiles and sequences to build a winning hand.'
      chineseSimplified: "1. \u67E5\u770B\u654C\u65B9\u820D\u724C\uFF0C\u4E0D\u9700\u8981\u65F6\u9009\u62E9\u8DF3\u8FC7\u3002\n2.
        \u8F6E\u5230\u4F60\u65F6\uFF0C\u4EA4\u6362\u6478\u724C\u533A\u4E0E\u624B\u724C\u4E2D\u7684\u724C\u3002\n3.
        \u786E\u8BA4\u6280\u80FD\u53CA\u548C\u724C\u673A\u4F1A\u540E\uFF0C\u70B9\u51FB\u201C\u820D\u724C\u201D\u3002\n\n\u5148\u6536\u96C6\u76F8\u540C\u724C\u6216\u8FDE\u7EED\u6570\u5B57\u7684\u724C\uFF0C\u4EE5\u548C\u724C\u4E3A\u76EE\u6807\u5427\u3002"
    hint:
      japanese: "\u300C\u5BFE\u5C40\u3092\u59CB\u3081\u308B\u300D\u3067\u518D\u958B\u3057\u307E\u3059\u3002\u3053\u306E\u6848\u5185\u306F\u6B21\u56DE\u304B\u3089\u81EA\u52D5\u8868\u793A\u3055\u308C\u307E\u305B\u3093\u3002"
      english: Press Start Match to resume. This guide will not appear automatically
        next time.
      chineseSimplified: "\u70B9\u51FB\u201C\u5F00\u59CB\u5BF9\u5C40\u201D\u7EE7\u7EED\u3002\u4E0B\u6B21\u4E0D\u4F1A\u81EA\u52A8\u663E\u793A\u6B64\u6307\u5357\u3002"
