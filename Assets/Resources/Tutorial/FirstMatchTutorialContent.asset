  skipTitle:
    japanese: "\u8AAC\u660E\u3092\u30B9\u30AD\u30C3\u30D7\u3057\u307E\u3059\u304B\uFF1F"
    english: Skip the guide?
    chineseSimplified: "\u8981\u8DF3\u8FC7\u8BF4\u660E\u5417\uFF1F"
  skipBody:
    japanese: "\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u3092\u7D42\u4E86\u3057\u3066\u5BFE\u5C40\u3092\u59CB\u3081\u307E\u3059\u3002\n\u3053\u306E\u6848\u5185\u306F\u6B21\u56DE\u304B\u3089\u81EA\u52D5\u8868\u793A\u3055\u308C\u307E\u305B\u3093\u3002\n\n\u8AAC\u660E\u3092\u7D9A\u3051\u308B\u5834\u5408\u306F\u300C\u623B\u308B\u300D\u3092\u9078\u3093\u3067\u304F\u3060\u3055\u3044\u3002"
    english: 'This ends the tutorial and starts the match.

      The guide will
      not appear automatically again.


      Choose Back to keep reading.'
    chineseSimplified: "\u7ED3\u675F\u6559\u7A0B\u5E76\u5F00\u59CB\u5BF9\u5C40\u3002\n\u4E0B\u6B21\u4E0D\u4F1A\u81EA\u52A8\u663E\u793A\u6B64\u6307\u5357\u3002\n\n\u5982\u9700\u7EE7\u7EED\u9605\u8BFB\uFF0C\u8BF7\u9009\u62E9\u201C\u8FD4\u56DE\u201D\u3002"
