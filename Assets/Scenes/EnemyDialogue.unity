--- !u!114 &80343900
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 80343897}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e813db3b750cafc4ca73341d2b0bbaeb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EnemyDialogueController
  enemyNameTMP: {fileID: 76465990}
  bodyTMP: {fileID: 1335277270}
  portraitImage: {fileID: 1266722129}
  nextButton: {fileID: 671624034}
  skipButton: {fileID: 671624034}
  battleSceneName: RunScene
  enemyInfoPanel: {fileID: 1748585189}
  enemyInfoNameTMP: {fileID: 297007347}
  enemyInfoHpTMP: {fileID: 1955217147}
  enemyInfoDeckTMP: {fileID: 639046210}
  enemyInfoFirstGemTMP: {fileID: 2136373242}
  enemyInfoSkillsTMP: {fileID: 638742999}
  startBattleButton: {fileID: 1422935620}
  lines: []
  perEnemyDialogues:
  - excelKey: 0
    enemyBaseName: "\u30A2\u30DE\u30C6\u30E9\u30B9"
    lines:
    - text: "\u5149\u306F\u795D\u798F\u306B\u3082\u88C1\u304D\u306B\u3082\u306A\u308B"
      textJapanese: "\u5149\u306F\u795D\u798F\u306B\u3082\u88C1\u304D\u306B\u3082\u306A\u308B"
      textEnglish: Light can be both a blessing and a judgment.
      textChineseSimplified: "\u5149\u65E2\u80FD\u6210\u4E3A\u795D\u798F\uFF0C\u4E5F\u80FD\u6210\u4E3A\u88C1\u51B3\u3002"
      portrait: {fileID: 21300000, guid: adf1fae389501d44fb63ca6347940716, type: 3}
    - text: "\u3042\u306A\u305F\u306B\u3069\u3061\u3089\u304C\u76F8\u5FDC\u3057\u3044\u306E\u304B"
      textJapanese: "\u3042\u306A\u305F\u306B\u3069\u3061\u3089\u304C\u76F8\u5FDC\u3057\u3044\u306E\u304B"
      textEnglish: Which one suits you will be decided now.
      textChineseSimplified: "\u81F3\u4E8E\u4F60\u66F4\u914D\u5F97\u4E0A\u54EA\u4E00\u79CD\uFF0C"
      portrait: {fileID: 21300000, guid: adf1fae389501d44fb63ca6347940716, type: 3}
    - text: "\u899A\u609F\u304C\u3042\u308B\u306A\u3089\u59CB\u3081\u307E\u3057\u3087\u3046"
      textJapanese: "\u899A\u609F\u304C\u3042\u308B\u306A\u3089\u59CB\u3081\u307E\u3057\u3087\u3046"
      textEnglish: If you are prepared, let us begin.
      textChineseSimplified: "\u82E5\u4F60\u5DF2\u6709\u89C9\u609F\uFF0C\u90A3\u5C31\u5F00\u59CB\u5427\u3002"
      portrait: {fileID: 21300000, guid: adf1fae389501d44fb63ca6347940716, type: 3}
  - excelKey: 1
    enemyBaseName: "\u30B9\u30B5\u30CE\u30AA"
    lines:
    - text: "\u8FF7\u3044\u304C\u3042\u308B\u306A\u3089\u4ECA\u3053\u3053\u3067\u6368\u3066\u308D"
      textJapanese: "\u8FF7\u3044\u304C\u3042\u308B\u306A\u3089\u4ECA\u3053\u3053\u3067\u6368\u3066\u308D"
      textEnglish: If you have any hesitation, cast it aside right here and now.
      textChineseSimplified: "\u82E5\u4F60\u8FD8\u6709\u8FF7\u60D8\uFF0C\u5C31\u5728\u6B64\u523B\u5C06\u5B83\u820D\u5F03\u3002"
      portrait: {fileID: 21300000, guid: cf32fcf0a1c073b45a0034e7444270b4, type: 3}
    - text: "\u724C\u306F\u512A\u3057\u304F\u306A\u3044"
      textJapanese: "\u724C\u306F\u512A\u3057\u304F\u306A\u3044"
      textEnglish: The tiles show no mercy.
      textChineseSimplified: "\u724C\u53EF\u4E0D\u4F1A\u6E29\u67D4\u4EE5\u5F85\u3002"
      portrait: {fileID: 21300000, guid: cf32fcf0a1c073b45a0034e7444270b4, type: 3}
    - text: "\u305D\u308C\u3067\u3082\u7ACB\u3064\u306A\u3089\u76F8\u624B\u3092\u3057\u3066\u3084\u308B"
      textJapanese: "\u305D\u308C\u3067\u3082\u7ACB\u3064\u306A\u3089\u76F8\u624B\u3092\u3057\u3066\u3084\u308B"
      textEnglish: Even so, if you still choose to stand, I will face you.
      textChineseSimplified: "\u5373\u4FBF\u5982\u6B64\uFF0C\u82E5\u4F60\u4ECD\u8981\u7AD9\u51FA\u6765\uFF0C\u6211\u5C31\u5949\u966A\u5230\u5E95\u3002"
      portrait: {fileID: 21300000, guid: cf32fcf0a1c073b45a0034e7444270b4, type: 3}
  - excelKey: 2
    enemyBaseName: "\u30D0\u30B9\u30C6\u30C8"
    lines:
    - text: "\u6050\u308C\u306F\u96A0\u305B\u306A\u3044\u3000\u5302\u3044\u3067\u308F\u304B\u308B"
      textJapanese: "\u6050\u308C\u306F\u96A0\u305B\u306A\u3044\u3000\u5302\u3044\u3067\u308F\u304B\u308B"
      textEnglish: You cannot hide your fear. I can smell it.
      textChineseSimplified: "\u6050\u60E7\u662F\u85CF\u4E0D\u4F4F\u7684\uFF0C\u6211\u95FB\u5F97\u51FA\u6765\u3002"
      portrait: {fileID: 21300000, guid: 6bebdd6e6ad94c54fbf41c72686bc22f, type: 3}
    - text: "\u3042\u306A\u305F\u306E\u672C\u6027\u898B\u305B\u3066\u307F\u3088"
      textJapanese: "\u3042\u306A\u305F\u306E\u672C\u6027\u898B\u305B\u3066\u307F\u3088"
      textEnglish: Show me your true nature.
      textChineseSimplified: "\u8BA9\u6211\u770B\u770B\u4F60\u7684\u672C\u6027\u3002"
      portrait: {fileID: 21300000, guid: 6bebdd6e6ad94c54fbf41c72686bc22f, type: 3}
  - excelKey: 3
    enemyBaseName: "\u30B7\u30F4\u30A1"
    lines:
    - text: "\u304A\u524D\u304C\u4F55\u3092\u5B88\u308A\u3001\u4F55\u3092\u6368\u3066\u308B\u306E\u304B"
      textJapanese: "\u304A\u524D\u304C\u4F55\u3092\u5B88\u308A\u3001\u4F55\u3092\u6368\u3066\u308B\u306E\u304B"
      textEnglish: Show me what you protect, and what you are willing to cast aside.
      textChineseSimplified: "\u4F60\u7A76\u7ADF\u8981\u5B88\u62A4\u4EC0\u4E48\uFF0C\u53C8\u8981\u820D\u5F03\u4EC0\u4E48\uFF0C"
      portrait: {fileID: 21300000, guid: 802870669fc5371489173f46314b3bc9, type: 3}
    - text: "\u3053\u306E\u8A66\u7DF4\u3067\u793A\u305B"
      textJapanese: "\u3053\u306E\u8A66\u7DF4\u3067\u793A\u305B"
      textEnglish: Prove it through this trial.
      textChineseSimplified: "\u5C31\u5728\u8FD9\u573A\u8BD5\u70BC\u4E2D\u8BC1\u660E\u7ED9\u6211\u770B\u3002"
      portrait: {fileID: 21300000, guid: 802870669fc5371489173f46314b3bc9, type: 3}
  - excelKey: 4
    enemyBaseName: "\u30A2\u30CC\u30D3\u30B9"
    lines:
    - text: "\u304A\u307E\u3048\u304C\u9078\u3093\u3060\u9053\u304C\u305D\u306E\u307E\u307E\u304A\u307E\u3048\u306E\u4FA1\u5024\u306B\u306A\u308B"
      textJapanese: "\u304A\u307E\u3048\u304C\u9078\u3093\u3060\u9053\u304C\u305D\u306E\u307E\u307E\u304A\u307E\u3048\u306E\u4FA1\u5024\u306B\u306A\u308B"
      textEnglish: The path you choose will become your very worth.
      textChineseSimplified: "\u4F60\u6240\u9009\u62E9\u7684\u9053\u8DEF\uFF0C\u5C06\u76F4\u63A5\u51B3\u5B9A\u4F60\u7684\u4EF7\u503C\u3002"
      portrait: {fileID: 21300000, guid: 3f5c050cabf1ee143a03bb39342bbf50, type: 3}
    - text: "\u30FB\u30FB\u30FB\u3055\u3042\u5BE9\u5224\u306E\u6642\u3060"
      textJapanese: "\u30FB\u30FB\u30FB\u3055\u3042\u5BE9\u5224\u306E\u6642\u3060"
      textEnglish: ...Now, it is time for judgment.
      textChineseSimplified: "\u2026\u2026\u6765\u5427\uFF0C\u5BA1\u5224\u7684\u65F6\u523B\u5230\u4E86\u3002"
      portrait: {fileID: 21300000, guid: 3f5c050cabf1ee143a03bb39342bbf50, type: 3}
  - excelKey: 5
    enemyBaseName: "\u30D5\u30EC\u30A4\u30E4"
    lines:
    - text: "\u6050\u308C\u3092\u62B1\u3044\u305F\u307E\u307E\u3067\u3082\u3044\u3044"
      textJapanese: "\u6050\u308C\u3092\u62B1\u3044\u305F\u307E\u307E\u3067\u3082\u3044\u3044"
      textEnglish: It is all right to carry fear within you.
      textChineseSimplified: "\u5373\u4F7F\u5FC3\u6000\u6050\u60E7\u4E5F\u6CA1\u5173\u7CFB\u3002"
      portrait: {fileID: 21300000, guid: ede461ef02bb00949b503ef494bc11ba, type: 3}
    - text: "\u9003\u3052\u306A\u3044\u306A\u3089\u305D\u308C\u306F\u52C7\u6C17\u3088"
      textJapanese: "\u9003\u3052\u306A\u3044\u306A\u3089\u305D\u308C\u306F\u52C7\u6C17\u3088"
      textEnglish: If you do not run, then that is courage.
      textChineseSimplified: "\u53EA\u8981\u4F60\u4E0D\u9003\u907F\uFF0C\u90A3\u5C31\u662F\u52C7\u6C14\u3002"
      portrait: {fileID: 21300000, guid: ede461ef02bb00949b503ef494bc11ba, type: 3}
    - text: "\u3055\u3042\u3042\u306A\u305F\u306E\u52C7\u6C17\u3092\u898B\u305B\u3066"
      textJapanese: "\u3055\u3042\u3042\u306A\u305F\u306E\u52C7\u6C17\u3092\u898B\u305B\u3066"
      textEnglish: Now, show me your courage.
      textChineseSimplified: "\u6765\u5427\uFF0C\u8BA9\u6211\u770B\u770B\u4F60\u7684\u52C7\u6C14\u3002"
      portrait: {fileID: 21300000, guid: ede461ef02bb00949b503ef494bc11ba, type: 3}
  - excelKey: 6
    enemyBaseName: "\u30DD\u30BB\u30A4\u30C9\u30F3"
    lines:
    - text: "\u6D77\u306F\u9759\u304B\u3067\u3082\u5E95\u306F\u8352\u308C\u3066\u3044\u308B"
      textJapanese: "\u6D77\u306F\u9759\u304B\u3067\u3082\u5E95\u306F\u8352\u308C\u3066\u3044\u308B"
      textEnglish: Even when the sea is calm, its depths are in turmoil.
      textChineseSimplified: "\u5373\u4F7F\u6D77\u9762\u5E73\u9759\uFF0C\u6DF1\u5904\u4E5F\u4F9D\u7136\u6C79\u6D8C\u3002"
      portrait: {fileID: 21300000, guid: d4b08ca1258c3b8498224974c6f04d52, type: 3}
    - text: "\u898B\u3048\u308B\u3082\u306E\u3060\u3051\u3067\u5224\u65AD\u3059\u308B\u306A"
      textJapanese: "\u898B\u3048\u308B\u3082\u306E\u3060\u3051\u3067\u5224\u65AD\u3059\u308B\u306A"
      textEnglish: Do not judge by appearances alone.
      textChineseSimplified: "\u4E0D\u8981\u53EA\u51ED\u773C\u524D\u6240\u89C1\u4E0B\u5224\u65AD\u3002"
      portrait: {fileID: 21300000, guid: d4b08ca1258c3b8498224974c6f04d52, type: 3}
    - text: "\u6D77\u306F\u9759\u304B\u3067\u3082\u5E95\u306F\u8352\u308C\u3066\u3044\u308B"
      textJapanese: "\u6D77\u306F\u9759\u304B\u3067\u3082\u5E95\u306F\u8352\u308C\u3066\u3044\u308B"
      textEnglish: Even when the sea is calm, its depths are in turmoil.
      textChineseSimplified: "\u5373\u4F7F\u6D77\u9762\u5E73\u9759\uFF0C\u6DF1\u5904\u4E5F\u4F9D\u7136\u6C79\u6D8C\u3002"
      portrait: {fileID: 21300000, guid: d4b08ca1258c3b8498224974c6f04d52, type: 3}
  - excelKey: 7
    enemyBaseName: "\u30AA\u30FC\u30C7\u30A3\u30F3"
    lines:
    - text: "\u52DD\u5229\u306F\u5076\u7136\u3067\u306F\u306A\u3044"
      textJapanese: "\u52DD\u5229\u306F\u5076\u7136\u3067\u306F\u306A\u3044"
      textEnglish: Victory is not a matter of chance.
      textChineseSimplified: "\u80DC\u5229\u5E76\u975E\u5076\u7136\u3002"
      portrait: {fileID: 21300000, guid: 8deb43bcb255d16438a80b3bfc7631ee, type: 3}
    - text: "\u7A4D\u307F\u91CD\u306D\u305F\u899A\u609F\u306E\u7D50\u679C\u3060"
      textJapanese: "\u7A4D\u307F\u91CD\u306D\u305F\u899A\u609F\u306E\u7D50\u679C\u3060"
      textEnglish: It is the result of resolve built up over time.
      textChineseSimplified: "\u90A3\u662F\u4E0D\u65AD\u79EF\u7D2F\u7684\u89C9\u609F\u6240\u5E26\u6765\u7684\u7ED3\u679C\u3002"
      portrait: {fileID: 21300000, guid: 8deb43bcb255d16438a80b3bfc7631ee, type: 3}
    - text: "\u898B\u305B\u3066\u307F\u308D"
      textJapanese: "\u898B\u305B\u3066\u307F\u308D"
      textEnglish: Show me.
      textChineseSimplified: "\u8BA9\u6211\u89C1\u8BC6\u4E00\u4E0B\u3002"
      portrait: {fileID: 21300000, guid: 8deb43bcb255d16438a80b3bfc7631ee, type: 3}
  - excelKey: 8
    enemyBaseName: "\u30EB\u30FC\u30CA"
    lines:
    - text: "\u591C\u306F\u9759\u304B\u306B\u4EBA\u306E\u5F31\u3055\u3092\u7167\u3089\u3059"
      textJapanese: "\u591C\u306F\u9759\u304B\u306B\u4EBA\u306E\u5F31\u3055\u3092\u7167\u3089\u3059"
      textEnglish: The night quietly reveals human weakness.
      textChineseSimplified: "\u9ED1\u591C\u4F1A\u9759\u9759\u7167\u51FA\u4EBA\u7684\u8106\u5F31\u3002"
      portrait: {fileID: 21300000, guid: 72c850920e66f934db1340c14a03b44d, type: 3}
    - text: "\u76EE\u3092\u80CC\u3051\u308B\u306A\u3089\u3053\u3053\u3067\u7D42\u308F\u308A"
      textJapanese: "\u76EE\u3092\u80CC\u3051\u308B\u306A\u3089\u3053\u3053\u3067\u7D42\u308F\u308A"
      textEnglish: If you turn away, it ends here.
      textChineseSimplified: "\u82E5\u4F60\u9009\u62E9\u9003\u907F\uFF0C\u5C31\u5230\u6B64\u4E3A\u6B62\u3002"
      portrait: {fileID: 21300000, guid: 72c850920e66f934db1340c14a03b44d, type: 3}
    - text: "\u5411\u304D\u5408\u3046\u306A\u3089\u6765\u306A\u3055\u3044"
      textJapanese: "\u5411\u304D\u5408\u3046\u306A\u3089\u6765\u306A\u3055\u3044"
      textEnglish: If you choose to face it, then come.
      textChineseSimplified: "\u82E5\u4F60\u9009\u62E9\u9762\u5BF9\uFF0C\u90A3\u5C31\u6765\u5427\u3002"
      portrait: {fileID: 21300000, guid: 72c850920e66f934db1340c14a03b44d, type: 3}
  - excelKey: 9
    enemyBaseName: "\u30BC\u30A6\u30B9"
    lines:
    - text: "\u3053\u3053\u307E\u3067\u6765\u305F\u306A\u3089\u3082\u3046\u9003\u3052\u9053\u306F\u306A\u3044"
      textJapanese: "\u3053\u3053\u307E\u3067\u6765\u305F\u306A\u3089\u3082\u3046\u9003\u3052\u9053\u306F\u306A\u3044"
      textEnglish: Now that you have come this far, there is no path left to retreat.
      textChineseSimplified: "\u65E2\u7136\u4F60\u5DF2\u7ECF\u8D70\u5230\u8FD9\u91CC\uFF0C\u5C31\u5DF2\u7ECF\u6CA1\u6709\u9000\u8DEF\u4E86\u3002"
      portrait: {fileID: 21300000, guid: 3ebabb4c1e957e64c914a0a970aa3b8f, type: 3}
    - text: "\u3055\u3042\u3000\u6765\u3044"
      textJapanese: "\u3055\u3042\u3000\u6765\u3044"
      textEnglish: Come.
      textChineseSimplified: "\u6765\u5427\u3002"
      portrait: {fileID: 21300000, guid: 3ebabb4c1e957e64c914a0a970aa3b8f, type: 3}
  - excelKey: 10
    enemyBaseName: "\u30CF\u30C7\u30B9"
    lines:
    - text: "\u30FB\u30FB\u30FB"
      textJapanese: "\u30FB\u30FB\u30FB"
      textEnglish: ...
      textChineseSimplified: ...
      portrait: {fileID: 8999240427594281835, guid: adcbe6a0187d7c846a825171eb10b8b0, type: 3}
