  m_Script: {fileID: 11500000, guid: 883202fac85252c48a47273e9cfeeeb4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedTextUI
  fallbackToJapaneseIfEmpty: 1
  english:
    text: The yaku assigned to passive skills differ from skill to skill, and each
      one has its own level. Yaku at level 0 do not activate the passive skill effect.
      The effect only activates when the yaku reaches level 1 or higher. At the start
      of a run, each passive skill has only one yaku at level 1. In the Upgrade Screen
      between battles, you can spend gold to raise the level of these yaku. However,
      if you are defeated, everything returns to its initial state.
  chineseSimplified:
    text: "\u5206\u914D\u7ED9\u88AB\u52A8\u6280\u80FD\u7684\u5F79\u79CD\u4F1A\u56E0\u6280\u80FD\u4E0D\u540C\u800C\u5404\u4E0D\u76F8\u540C\uFF0C\u5E76\u4E14\u6BCF\u4E2A\u5F79\u79CD\u90FD\u8BBE\u6709\u5404\u81EA\u7684\u7B49\u7EA7\u3002\u7B49\u7EA7\u4E3A0\u7684\u5F79\u79CD\u4E0D\u4F1A\u89E6\u53D1\u88AB\u52A8\u6280\u80FD\u6548\u679C\uFF0C\u53EA\u6709\u8FBE\u52301\u7EA7\u4EE5\u4E0A\u65F6\u6548\u679C\u624D\u4F1A\u751F\u6548\u3002\u5728\u5F00\u59CB\u6218\u6597\u65F6\uFF0C\u6BCF\u79CD\u88AB\u52A8\u6280\u80FD\u90FD\u53EA\u6709\u4E00\u4E2A1\u7EA7\u5F79\u79CD\u3002\u5728\u6218\u6597\u95F4\u9699\u7684\u5F3A\u5316\u754C\u9762\u4E2D\uFF0C\u4F60\u53EF\u4EE5\u6D88\u8017\u91D1\u5E01\u6765\u63D0\u5347\u8FD9\u4E9B\u5F79\u79CD\u7684\u7B49\u7EA7\u3002\u4E0D\u8FC7\uFF0C\u4E00\u65E6\u6218\u8D25\uFF0C\u4E00\u5207\u90FD\u4F1A\u6062\u590D\u5230\u521D\u59CB\u72B6\u6001\u3002"
