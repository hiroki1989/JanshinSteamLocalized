  m_Script: {fileID: 11500000, guid: 883202fac85252c48a47273e9cfeeeb4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedTextUI
  fallbackToJapaneseIfEmpty: 1
  english:
    text: When you equip a special tile, it is added to your deck as a red dora.
      Depending on its rarity, a special tile may enhance the effects of your passive
      skills or possess a unique special effect. You can equip up to four special
      tiles. At the start, however, you can only equip one, so offer gems to increase
      your number of equipment slots.
  chineseSimplified:
    text: "\u88C5\u5907\u7279\u6B8A\u724C\u540E\uFF0C\u5B83\u4F1A\u4F5C\u4E3A\u7EA2\u5B9D\u724C\u52A0\u5165\u4F60\u7684\u724C\u7EC4\u3002\u6839\u636E\u7A00\u6709\u5EA6\u7684\u4E0D\u540C\uFF0C\u7279\u6B8A\u724C\u6709\u7684\u4F1A\u5F3A\u5316\u88AB\u52A8\u6280\u80FD\u7684\u6548\u679C\uFF0C\u6709\u7684\u5219\u62E5\u6709\u72EC\u7279\u7684\u7279\u6B8A\u6548\u679C\u3002\u7279\u6B8A\u724C\u6700\u591A\u53EF\u4EE5\u88C5\u59074\u4E2A\u3002\u521D\u59CB\u72B6\u6001\u4E0B\u53EA\u80FD\u88C5\u59071\u4E2A\uFF0C\u6240\u4EE5\u732E\u4E0A\u5B9D\u77F3\u6765\u589E\u52A0\u88C5\u5907\u680F\u4F4D\u5427\u3002"
