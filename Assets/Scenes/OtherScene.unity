  m_Script: {fileID: 11500000, guid: 883202fac85252c48a47273e9cfeeeb4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedTextUI
  fallbackToJapaneseIfEmpty: 1
  english:
    text: Once you are in tenpai, you can declare riichi. However, when you declare
      riichi, the four tiles currently in the draw area are immediately discarded
      to the table. Even if one of them is your winning tile, you cannot win on it,
      but there is no furiten, so do not hesitate to declare riichi. Choose a good
      wait and go for riichi. Of course, if you can aim for enough points, you may
      also choose to win by tsumo without declaring riichi.
  chineseSimplified:
    text: "\u542C\u724C\u540E\uFF0C\u4F60\u53EF\u4EE5\u5BA3\u544A\u7ACB\u76F4\u3002\u4E0D\u8FC7\uFF0C\u4E00\u65E6\u5BA3\u544A\u7ACB\u76F4\uFF0C\u5F53\u524D\u6478\u724C\u533A\u4E2D\u76844\u5F20\u724C\u4F1A\u7ACB\u523B\u88AB\u5F03\u7F6E\u5230\u573A\u4E0A\u3002\u5373\u4F7F\u5176\u4E2D\u6709\u548C\u724C\u6240\u9700\u7684\u724C\uFF0C\u4F60\u4E5F\u4E0D\u80FD\u548C\u724C\uFF0C\u4F46\u8FD9\u91CC\u6CA1\u6709\u632F\u542C\uFF0C\u56E0\u6B64\u4E0D\u5FC5\u987E\u8651\uFF0C\u653E\u5FC3\u7ACB\u76F4\u5373\u53EF\u3002\u8BF7\u9009\u62E9\u597D\u7684\u542C\u724C\u5F62\u5F0F\u540E\u518D\u7ACB\u76F4\u3002\u5F53\u7136\uFF0C\u5982\u679C\u4F60\u5DF2\u7ECF\u80FD\u4E89\u53D6\u5230\u8DB3\u591F\u7684\u70B9\u6570\uFF0C\u4E5F\u53EF\u4EE5\u4E0D\u7ACB\u76F4\uFF0C\u76F4\u63A5\u81EA\u6478\u548C\u724C\u3002"
