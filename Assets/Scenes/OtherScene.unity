  m_text: "\u30C6\u30F3\u30D1\u30A4\u3057\u305F\u3089\u30EA\u30FC\u30C1\u3092\u304B\u3051\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3002\n\u305F\u3060\u3057\u3001\u30EA\u30FC\u30C1\u3092\u304B\u3051\u308B\u3068\u305D\u306E\u6642\u70B9\u3067\u30C4\u30E2\u5834\u306B\u3042\u308B4\u679A\u306E\u724C\u306F\u5373\u5EA7\u306B\u5834\u306B\u6368\u3066\u3089\u308C\u308B\u3002\n\u305D\u306E\u4E2D\u306B\u30A2\u30AC\u30EA\u724C\u304C\u3042\u3063\u3066\u3082\u548C\u4E86\u3059\u308B\u3053\u3068\u306F\u3067\u304D\u306A\u3044\u304C\u3001\u30D5\u30EA\u30C6\u30F3\u306F\u306A\u3044\u304B\u3089\u9060\u616E\u306A\u304F\u30EA\u30FC\u30C1\u3092\u304B\u3051\u3066\u3044\u3044\u3002\u826F\u3044\u5F85\u3061\u3092\u9078\u3093\u3067\u30EA\u30FC\u30C1\u3092\u304B\u3051\u3088\u3046\u3002\n\u3082\u3061\u308D\u3093\u3001\u5341\u5206\u306A\u70B9\u6570\u304C\u72D9\u3048\u308B\u306E\u306A\u3089\u30EA\u30FC\u30C1\u3092\u304B\u3051\u306A\u3044\u3067\u30C4\u30E2\u30A2\u30AC\u30EA\u3057\u3066\u3082\u3044\u3044\u3002"
