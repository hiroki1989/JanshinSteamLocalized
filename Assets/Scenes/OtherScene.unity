  m_Script: {fileID: 11500000, guid: 883202fac85252c48a47273e9cfeeeb4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedTextUI
  fallbackToJapaneseIfEmpty: 1
  english:
    text: 'Your opponents are gods. They will not resort to petty tricks like stealing
      your tiles with pon or chi. When a god reaches tenpai, it will declare riichi
      openly and honorably. But do not let your guard down. As gods, your enemies
      are always the dealer. They may even wield powers beyond human understanding
      and use skills of their own.


      You will battle against ten gods. And
      when your yaku reach their fullness in the battle against the final god...'
  chineseSimplified:
    text: "\u4E0E\u4F60\u5BF9\u5CD9\u7684\u654C\u4EBA\u662F\u4F17\u795E\u3002\u4ED6\u4EEC\u4E0D\u4F1A\u7528\u78B0\u3001\u5403\u4E4B\u7C7B\u7684\u5C0F\u624B\u6BB5\u4ECE\u73A9\u5BB6\u624B\u4E2D\u593A\u724C\u3002\u5F53\u5929\u795E\u542C\u724C\u65F6\uFF0C\u4ED6\u4EEC\u4F1A\u5802\u5802\u6B63\u6B63\u5730\u5BA3\u544A\u7ACB\u76F4\u3002\u7136\u800C\u4E0D\u8981\u5927\u610F\u3002\u6B63\u56E0\u4E3A\u5BF9\u624B\u662F\u795E\uFF0C\u4ED6\u4EEC\u59CB\u7EC8\u90FD\u662F\u5E84\u5BB6\u3002\u8FD8\u53EF\u80FD\u65BD\u5C55\u8D85\u8D8A\u4EBA\u667A\u7684\u529B\u91CF\uFF0C\u4F7F\u7528\u5C5E\u4E8E\u4ED6\u4EEC\u81EA\u5DF1\u7684\u6280\u80FD\u3002\n\n\u73A9\u5BB6\u5C06\u4E0E\u5341\u4F4D\u795E\u660E\u4EA4\u6218\u3002\u800C\u5F53\u4F60\u5728\u4E0E\u6700\u540E\u4E00\u4F4D\u795E\u7684\u6218\u6597\u4E2D\u8BA9\u5F79\u6EE1\u76C8\u4E4B\u65F6\u2026\u2026"
