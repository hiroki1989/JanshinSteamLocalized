  m_Script: {fileID: 11500000, guid: 883202fac85252c48a47273e9cfeeeb4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedTextUI
  fallbackToJapaneseIfEmpty: 1
  english:
    text: By spending gold in the Upgrade Screen between battles against the gods,
      you can purchase ofuda, recover HP and MP, strengthen your stats, build your
      deck, and enhance your passive skills. Any upgrades made in the Upgrade Screen
      return to their initial state if you are defeated. The effects of ofuda can
      be extremely powerful when used well. If one seems promising, try picking it
      up for now.
  chineseSimplified:
    text: "\u5728\u4E0E\u4F17\u795E\u6218\u6597\u4E4B\u95F4\u7684\u5F3A\u5316\u754C\u9762\u4E2D\uFF0C\u6D88\u8017\u91D1\u5E01\u540E\uFF0C\u4F60\u53EF\u4EE5\u8D2D\u4E70\u5FA1\u672D\u3001\u56DE\u590DHP\u548CMP\u3001\u5F3A\u5316\u5C5E\u6027\u3001\u6784\u7B51\u724C\u7EC4\uFF0C\u4EE5\u53CA\u5F3A\u5316\u88AB\u52A8\u6280\u80FD\u3002\u5728\u5F3A\u5316\u754C\u9762\u4E2D\u8FDB\u884C\u7684\u5F3A\u5316\u4E00\u65E6\u6218\u8D25\uFF0C\u90FD\u4F1A\u6062\u590D\u5230\u521D\u59CB\u72B6\u6001\u3002\u5FA1\u672D\u7684\u6548\u679C\u5982\u679C\u8FD0\u7528\u5F97\u5F53\u4F1A\u975E\u5E38\u5F3A\u529B\u3002\u53EA\u8981\u89C9\u5F97\u4E0D\u9519\uFF0C\u5C31\u5148\u8BD5\u7740\u5165\u624B\u5427\u3002"
