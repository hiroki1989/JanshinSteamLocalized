  m_text: "\u5404\u30D7\u30EC\u30A4\u30E4\u30FC\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u306F\u3001MP\u3092\u6D88\u8CBB\u3057\u3066\u4F7F\u7528\u3059\u308B\u30A2\u30AF\u30C6\u30A3\u30D6\u30B9\u30AD\u30EB\u3068\u3001\u88C5\u5099\u3057\u3066\u3044\u308B\u3060\u3051\u3067\u52B9\u679C\u304C\u767A\u52D5\u3059\u308B\u30D1\u30C3\u30B7\u30D6\u30B9\u30AD\u30EB\u3092\u6301\u3063\u3066\u3044\u308B\u3002\n\u30A2\u30AF\u30C6\u30A3\u30D6\u30B9\u30AD\u30EB\u306F\u3001\u5BFE\u5C40\u3092\u6709\u5229\u306B\u3059\u308B\u305F\u3081\u306B\u5FC5\u9808\u306E\u6226\u7565\u3060\u3002MP\u306F\u6BCE\u30BF\u30FC\u30F3\u4E00\u5B9A\u91CF\u56DE\u5FA9\u3059\u308B\u304B\u3089\u7A4D\u6975\u7684\u306B\u4F7F\u3046\u3068\u3044\u3044\u3002\n\n\u30D1\u30C3\u30B7\u30D6\u30B9\u30AD\u30EB\u306F\u3001\u6483\u3001\u7652\u3001\u77AC\u306E3\u7A2E\u985E\u304C\u3042\u308A\u3001\u30D7\u30EC\u30A4\u30E4\u30FC\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u3054\u3068\u306B\u7570\u306A\u308B\u5F79\u304C\u5272\u308A\u5F53\u3066\u3089\u308C\u3066\u3044\u308B\u3002\n\u6483\u306B\u5272\u308A\u5F53\u3066\u3089\u308C\u3066\u3044\u308B\u5F79\u3092\u548C\u4E86\u3059\u308B\u3068\u3001\u6575\u3078\u306E\u30C0\u30E1\u30FC\u30B8\u304CX%\u52A0\u7B97\u3055\u308C\u308B\u3002\n\u7652\u306B\u5272\u308A\u5F53\u3066\u3089\u308C\u3066\u3044\u308B\u5F79\u3092\u548C\u4E86\u3059\u308B\u3068\u3001\u57FA\u790E\u70B9\u306EX%\u76F8\u5F53\u306E\u30D7\u30EC\u30A4\u30E4\u30FCHP\u304C\u56DE\u5FA9\u3059\u308B\u3002\n\u77AC\u306B\u5272\u308A\u5F53\u3066\u3089\u308C\u3066\u3044\u308B\u5F79\u3092\u548C\u4E86\u3059\u308B\u3068\u3001\u57FA\u790E\u70B9\u306EX%\u76F8\u5F53\u306E\u30D7\u30EC\u30A4\u30E4\u30FCMP\u304C\u56DE\u5FA9\u3059\u308B\u3002\n\n\u307E\u305A\u306F\u5148\u624B\u5FC5\u52DD\u3002\u30A2\u30AF\u30C6\u30A3\u30D6\u30B9\u30AD\u30EB\u3092\u6709\u52B9\u306B\u4F7F\u3044\u306A\u304C\u3089\u3001\u6483\u306E\u5F79\u3092\u72D9\u3063\u3066\u3044\u3053\u3046\u3002HP\u3084MP\u304C\u5C11\u306A\u304F\u306A\u3063\u3066\u304D\u305F\u3089\u7652\u3084\u77AC\u306E\u5F79\u3092\u72D9\u3063\u3066\u56DE\u5FA9\u3059\u308B\u3093\u3060\u3002"
