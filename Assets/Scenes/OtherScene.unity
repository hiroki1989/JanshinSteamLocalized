--- !u!114 &468863809
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 468863805}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 883202fac85252c48a47273e9cfeeeb4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedTextUI
  fallbackToJapaneseIfEmpty: 1
  english:
    text: "Each playable character has an active skill that consumes MP and a passive
      skill that takes effect simply by being equipped. Active skills are an essential
      part of your strategy for gaining the upper hand in battle. Since MP recovers
      by a fixed amount each turn, you should use them proactively.\n\nPassive skills
      come in three types: \u6483, \u7652, and \u77AC. Each playable character is
      assigned different yaku for these categories. When you win with a yaku assigned
      to \u6483, X% bonus damage is added to the damage dealt to the enemy. When
      you win with a yaku assigned to \u7652, you recover player HP equal to X% of
      the base points. When you win with a yaku assigned to \u77AC, you recover player
      MP equal to X% of the base points.\n\nSeize the initiative first. Make effective
      use of your active skill while aiming for \u6483 yaku. When your HP or MP starts
      to run low, aim for \u7652 or \u77AC yaku to recover."
  chineseSimplified:
    text: "\u6BCF\u4E2A\u53EF\u64CD\u4F5C\u89D2\u8272\u90FD\u62E5\u6709\u4E00\u4E2A\u9700\u8981\u6D88\u8017MP\u4F7F\u7528\u7684\u4E3B\u52A8\u6280\u80FD\uFF0C\u4EE5\u53CA\u4E00\u4E2A\u53EA\u8981\u88C5\u5907\u4E0A\u5C31\u4F1A\u751F\u6548\u7684\u88AB\u52A8\u6280\u80FD\u3002\u4E3B\u52A8\u6280\u80FD\u662F\u8BA9\u5BF9\u5C40\u671D\u6709\u5229\u65B9\u5411\u53D1\u5C55\u7684\u5173\u952E\u7B56\u7565\u3002MP\u6BCF\u56DE\u5408\u90FD\u4F1A\u6062\u590D\u4E00\u5B9A\u6570\u503C\uFF0C\u56E0\u6B64\u5EFA\u8BAE\u79EF\u6781\u4F7F\u7528\u3002\n\n\u88AB\u52A8\u6280\u80FD\u5206\u4E3A\u6483\u3001\u7652\u3001\u77AC\u4E09\u79CD\uFF0C\u6BCF\u4E2A\u89D2\u8272\u90FD\u4F1A\u5206\u522B\u5BF9\u5E94\u4E0D\u540C\u7684\u5F79\u79CD\u3002\u548C\u51FA\u88AB\u5206\u914D\u4E3A\u6483\u7684\u5F79\u79CD\u65F6\uFF0C\u4F1A\u5BF9\u654C\u4EBA\u8FFD\u52A0X%\u7684\u4F24\u5BB3\u3002\u548C\u51FA\u88AB\u5206\u914D\u4E3A\u7652\u7684\u5F79\u79CD\u65F6\uFF0C\u73A9\u5BB6\u4F1A\u56DE\u590D\u76F8\u5F53\u4E8E\u57FA\u7840\u70B9X%\u7684HP\u3002\u548C\u51FA\u88AB\u5206\u914D\u4E3A\u77AC\u7684\u5F79\u79CD\u65F6\uFF0C\u73A9\u5BB6\u4F1A\u56DE\u590D\u76F8\u5F53\u4E8E\u57FA\u7840\u70B9X%\u7684MP\u3002\n\n\u9996\u5148\u8981\u62A2\u5360\u5148\u673A\u3002\u4E00\u8FB9\u6709\u6548\u4F7F\u7528\u4E3B\u52A8\u6280\u80FD\uFF0C\u4E00\u8FB9\u4F18\u5148\u7784\u51C6\u6483\u7684\u5F79\u79CD\u3002\u5F53HP\u6216MP\u5F00\u59CB\u4E0D\u8DB3\u65F6\uFF0C\u5C31\u6539\u4E3A\u7784\u51C6\u7652\u6216\u77AC\u7684\u5F79\u79CD\u6765\u8FDB\u884C\u56DE\u590D\u3002"
