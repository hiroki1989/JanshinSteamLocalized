  m_Script: {fileID: 11500000, guid: 883202fac85252c48a47273e9cfeeeb4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedTextUI
  fallbackToJapaneseIfEmpty: 1
  english:
    text: "Battles against the gods are fought one on one. The gods take damage based
      on the score of the player\u2019s winning hand. Of course, the gods will show
      no mercy. The player also takes damage when a god wins a hand.\n\nThe match
      lasts until South 4, and each round ends in a draw after 12 turns. You are
      defeated when your HP reaches 0. But even in defeat, that is not the end. You
      are not allowed to end here. Prepare for the next battle."
  chineseSimplified:
    text: "\u4E0E\u4F17\u795E\u7684\u6218\u6597\u5C06\u4EE5\u4E00\u5BF9\u4E00\u7684\u5F62\u5F0F\u8FDB\u884C\u3002\u795E\u660E\u4F1A\u6839\u636E\u73A9\u5BB6\u548C\u724C\u7684\u70B9\u6570\u53D7\u5230\u4F24\u5BB3\u3002\u5F53\u7136\uFF0C\u4F17\u795E\u4E5F\u7EDD\u4E0D\u4F1A\u624B\u4E0B\u7559\u60C5\u3002\u5F53\u795E\u660E\u548C\u724C\u65F6\uFF0C\u73A9\u5BB6\u4E5F\u4F1A\u53D7\u5230\u4F24\u5BB3\u3002\n\n\u5BF9\u5C40\u8FDB\u884C\u5230\u53574\u5C40\u4E3A\u6B62\uFF0C\u6BCF\u5C40\u572812\u56DE\u5408\u540E\u6D41\u5C40\u3002\n\n\u5F53\u73A9\u5BB6\u7684HP\u964D\u4E3A0\u65F6\uFF0C\u5C31\u4F1A\u8D25\u5317\u3002\u4F46\u5373\u4F7F\u8D25\u5317\uFF0C\u4E5F\u5E76\u975E\u5C31\u6B64\u7ED3\u675F\u3002\u4F60\u4E0D\u88AB\u5141\u8BB8\u5728\u6B64\u6B62\u6B65\u3002\u4E3A\u4E0B\u4E00\u573A\u6218\u6597\u505A\u597D\u51C6\u5907\u3002"
