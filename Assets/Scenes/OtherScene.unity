  m_text: "\u795E\u3005\u3068\u306E\u95D8\u3044\u306E\u5408\u9593\u306E\u5F37\u5316\u753B\u9762\u3067\u30B4\u30FC\u30EB\u30C9\u3092\u6D88\u8CBB\u3059\u308B\u3053\u3068\u3067\u3001\u304A\u672D\u306E\u8CFC\u5165\u3001HP\u3084MP\u306E\u56DE\u5FA9\u3001\u30B9\u30C6\u30FC\u30BF\u30B9\u306E\u5F37\u5316\u3001\u30C7\u30C3\u30AD\u306E\u69CB\u7BC9\u3001\u30D1\u30C3\u30B7\u30D6\u30B9\u30AD\u30EB\u306E\u5F37\u5316\u3092\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3002\n\u5F37\u5316\u753B\u9762\u3067\u306E\u5F37\u5316\u306F\u3001\u95D8\u3044\u306B\u6557\u308C\u308B\u3068\u521D\u671F\u72B6\u614B\u306B\u623B\u308B\u3002\n\u304A\u672D\u306E\u52B9\u679C\u306F\u3046\u307E\u304F\u4F7F\u3048\u3070\u975E\u5E38\u306B\u5F37\u529B\u3060\u3002\u3088\u3055\u305D\u3046\u3068\u601D\u3063\u305F\u3089\u3068\u308A\u3042\u3048\u305A\u624B\u306B\u5165\u308C\u3066\u307F\u3088\u3046\u3002"
