  m_text: "\u795E\u3005\u3068\u306E\u95D8\u3044\u3092\u7E70\u308A\u8FD4\u3059\u3053\u3068\u3067\u3001\u304A\u5B88\u308A\u3092\u624B\u306B\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3002\n\u304A\u5B88\u308A\u3092\u88C5\u5099\u3059\u308B\u3053\u3068\u3067\u3001\u30B9\u30C6\u30FC\u30BF\u30B9\u3092\u5F37\u5316\u3057\u305F\u308A\u30D1\u30C3\u30B7\u30D6\u30B9\u30AD\u30EB\u306E\u52B9\u679C\u3092\u4E0A\u6607\u3055\u305B\u305F\u308A\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3002\n\n\u795E\u3005\u3092\u6483\u7834\u3057\u305F\u3068\u304D\u3001\u307E\u308C\u306B\u795E\u5668\u3092\u624B\u306B\u3059\u308B\u3053\u3068\u3082\u3042\u308B\u3060\u308D\u3046\u3002\u795E\u5668\u306F\u975E\u5E38\u306B\u5F37\u529B\u3060\u3002\u73FE\u72B6\u3092\u6253\u7834\u3059\u308B\u6C7A\u3081\u624B\u306B\u306A\u308B\u3060\u308D\u3046\u3002"
