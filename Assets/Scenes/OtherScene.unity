  m_text: "\u30D1\u30C3\u30B7\u30D6\u30B9\u30AD\u30EB\u306B\u5272\u308A\u5F53\u3066\u3089\u308C\u3066\u3044\u308B\u5F79\u306F\u3001\u30B9\u30AD\u30EB\u3054\u3068\u306B\u7570\u306A\u308B\u4E0A\u3001\u305D\u308C\u305E\u308C\u7570\u306A\u308B\u30EC\u30D9\u30EB\u304C\u8A2D\u5B9A\u3055\u308C\u3066\u3044\u308B\u3002\n\u30EC\u30D9\u30EB0\u306E\u5F79\u306F\u30D1\u30C3\u30B7\u30D6\u30B9\u30AD\u30EB\u306E\u52B9\u679C\u304C\u767A\u52D5\u3057\u306A\u3044\u3002\u30EC\u30D9\u30EB1\u4EE5\u4E0A\u306B\u306A\u308B\u3068\u52B9\u679C\u304C\u767A\u52D5\u3059\u308B\u3002\n\u5BFE\u5C40\u3092\u958B\u59CB\u3057\u305F\u6BB5\u968E\u3067\u306F\u3001\u30EC\u30D9\u30EB1\u306E\u5F79\u306F\u5404\u30D1\u30C3\u30B7\u30D6\u30B9\u30AD\u30EB\u3054\u3068\u306B\u4E00\u3064\u305A\u3064\u3060\u3051\u3060\u3002\n\u95D8\u3044\u306E\u5408\u9593\u306E\u5F37\u5316\u753B\u9762\u3067\u3001\u30B4\u30FC\u30EB\u30C9\u3092\u6D88\u8CBB\u3059\u308B\u3053\u3068\u3067\u5F79\u306E\u30EC\u30D9\u30EB\u3092\u4E0A\u3052\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3002\n\u305F\u3060\u3057\u3001\u95D8\u3044\u306B\u6557\u308C\u308B\u3068\u521D\u671F\u72B6\u614B\u306B\u623B\u308B\u3002"
