  m_Script: {fileID: 11500000, guid: 883202fac85252c48a47273e9cfeeeb4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LocalizedTextUI
  fallbackToJapaneseIfEmpty: 1
  english:
    text: 'By continuing to battle the gods, you can obtain omamori. Equipping omamori
      allows you to strengthen your stats and enhance the effects of your passive
      skills.


      When you defeat a god, you may occasionally obtain a divine
      relic. Divine relics are immensely powerful. They may become the key to breaking
      through your current limits.'
  chineseSimplified:
    text: "\u901A\u8FC7\u4E0D\u65AD\u4E0E\u4F17\u795E\u4EA4\u6218\uFF0C\u4F60\u53EF\u4EE5\u83B7\u5F97\u5FA1\u5B88\u3002\u88C5\u5907\u5FA1\u5B88\u540E\uFF0C\u53EF\u4EE5\u5F3A\u5316\u81EA\u8EAB\u5C5E\u6027\uFF0C\u4E5F\u53EF\u4EE5\u63D0\u5347\u88AB\u52A8\u6280\u80FD\u7684\u6548\u679C\u3002\n\n\u51FB\u8D25\u795E\u660E\u65F6\uFF0C\u4F60\u5076\u5C14\u8FD8\u53EF\u80FD\u83B7\u5F97\u795E\u5668\u3002\u795E\u5668\u62E5\u6709\u6781\u5176\u5F3A\u5927\u7684\u529B\u91CF\uFF0C\u6216\u8BB8\u4F1A\u6210\u4E3A\u6253\u7834\u73B0\u72B6\u7684\u5173\u952E\u3002"
