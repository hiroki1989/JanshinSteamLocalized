  m_text: "\u795E\u3005\u3068\u306E\u95D8\u3044\u306F1\u5BFE1\u3067\u6311\u3080\u3053\u3068\u306B\u306A\u308B\u3002\n\u30D7\u30EC\u30A4\u30E4\u30FC\u304C\u548C\u4E86\u3057\u305F\u70B9\u6570\u306B\u5FDC\u3058\u3066\u795E\u306F\u30C0\u30E1\u30FC\u30B8\u3092\u53D7\u3051\u308B\u3002\n\u3082\u3061\u308D\u3093\u3001\u795E\u3005\u3082\u5BB9\u8D66\u3057\u306A\u3044\u3060\u308D\u3046\u3002\n\u795E\u306E\u548C\u4E86\u306B\u3088\u3063\u3066\u30D7\u30EC\u30A4\u30E4\u30FC\u3082\u30C0\u30E1\u30FC\u30B8\u3092\u53D7\u3051\u308B\u3002\n\n\u5C40\u306F\u53574\u5C40\u307E\u3067\u30021\u5C40\u306F12\u30BF\u30FC\u30F3\u3067\u6D41\u5C40\u3059\u308B\u3002\n\n\u30D7\u30EC\u30A4\u30E4\u30FC\u306EHP\u304C0\u306B\u306A\u3063\u305F\u3089\u6557\u5317\u3060\u3002\n\u3060\u304C\u6557\u308C\u3066\u3082\u305D\u3053\u3067\u7D42\u308F\u308A\u3067\u306F\u306A\u3044\u3002\n\u7D42\u308F\u308B\u3053\u3068\u306F\u8A31\u3055\u308C\u306A\u3044\u3002\u6B21\u306E\u95D8\u3044\u306B\u5099\u3048\u3088\u3002"
