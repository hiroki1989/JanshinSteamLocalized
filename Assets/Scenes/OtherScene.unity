  m_text: "\u76F8\u5BFE\u3059\u308B\u6575\u306F\u795E\u3005\u3060\u3002\u30DD\u30F3\u3084\u30C1\u30FC\u306A\u3069\u3067\u30D7\u30EC\u30A4\u30E4\u30FC\u304B\u3089\u59D1\u606F\u306B\u724C\u3092\u596A\u3046\u3053\u3068\u306F\u3057\u306A\u3044\u3002\n\u795E\u304C\u30C6\u30F3\u30D1\u30A4\u3059\u308B\u3068\u6B63\u3005\u5802\u3005\u3068\u30EA\u30FC\u30C1\u3092\u304B\u3051\u3066\u304F\u308B\u3060\u308D\u3046\u3002\n\u3057\u304B\u3057\u6CB9\u65AD\u3059\u308B\u306A\u3002\u6575\u306F\u795E\u3086\u3048\u306B\u5E38\u306B\u89AA\u756A\u3060\u3002\n\u4EBA\u667A\u3092\u8D85\u3048\u30B9\u30AD\u30EB\u3082\u4F7F\u3063\u3066\u304F\u308B\u3053\u3068\u3082\u3042\u308B\u3002\n\n\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u5341\u306E\u795E\u3005\u3068\u95D8\u3046\u3053\u3068\u306B\u306A\u308B\u3002\u6700\u5F8C\u306E\u795E\u3068\u306E\u95D8\u3044\u306B\u304A\u3044\u3066\u5F79\u304C\u6E80\u3061\u305F\u3068\u304D\u30FB\u30FB\u30FB"
