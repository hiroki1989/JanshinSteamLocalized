  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 501e2971b6f727a41baad231f1852d25, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AngelDialogueController
  speakerTMP: {fileID: 76465990}
  bodyTMP: {fileID: 1335277270}
  portraitImage: {fileID: 1266722129}
  nextButton: {fileID: 671624034}
  skipButton: {fileID: 671624034}
  battleSceneName: RunScene
  lines:
  - speaker: "\u5929\u4F7F"
    speakerJapanese: "\u5929\u4F7F"
    speakerEnglish: Angel
    speakerChineseSimplified: "\u5929\u4F7F"
    text: "\u76EE\u899A\u3081\u305F\u308F\u306D"
    textJapanese: 
    textEnglish: "You\u2019re awake."
    textChineseSimplified: "\u4F60\u9192\u4E86\u3002"
    portrait: {fileID: 21300000, guid: 0118ce754b789f04ea8c17acfb78ce10, type: 3}
  - speaker: "\u5929\u4F7F"
    speakerJapanese: "\u5929\u4F7F"
    speakerEnglish: Angel
    speakerChineseSimplified: "\u5929\u4F7F"
    text: "\u4E16\u754C\u306E\u5747\u8861\u304C\u5C11\u3057\u305A\u3064\u305A\u308C\u3066\u3044\u308B\u30FB\u30FB\u30FB\r"
    textJapanese: "\u4E16\u754C\u306E\u5747\u8861\u304C\u5C11\u3057\u305A\u3064\u305A\u308C\u3066\u3044\u308B\u30FB\u30FB\u30FB"
    textEnglish: The balance of the world is slowly falling apart.
    textChineseSimplified: "\u4E16\u754C\u7684\u5E73\u8861\u6B63\u5728\u4E00\u70B9\u70B9\u5D29\u574F\u3002"
    portrait: {fileID: 21300000, guid: 0118ce754b789f04ea8c17acfb78ce10, type: 3}
  - speaker: "\u5929\u4F7F"
    speakerJapanese: "\u5929\u4F7F"
    speakerEnglish: Angel
    speakerChineseSimplified: "\u5929\u4F7F"
    text: "\u3042\u306A\u305F\u306F\u305D\u306E\u6B6A\u307F\u3092\u6B63\u3059\u305F\u3081\u306B\u9078\u3070\u308C\u305F\u306E"
    textJapanese: "\u3042\u306A\u305F\u306F\u305D\u306E\u6B6A\u307F\u3092\u6B63\u3059\u305F\u3081\u306B\u9078\u3070\u308C\u305F\u306E"
    textEnglish: You were chosen to correct that distortion.
    textChineseSimplified: "\u4F60\u88AB\u9009\u4E2D\u6765\u7EA0\u6B63\u8FD9\u4EFD\u626D\u66F2\u3002"
    portrait: {fileID: 21300000, guid: 0118ce754b789f04ea8c17acfb78ce10, type: 3}
  - speaker: "\u5929\u4F7F"
    speakerJapanese: "\u5929\u4F7F"
    speakerEnglish: Angel
    speakerChineseSimplified: "\u5929\u4F7F"
    text: "\u3055\u3042\u624B\u3092\u6574\u3048 \u76EE\u3092\u6F84\u307E\u305B\u3066\u9032\u307F\u306A\u3055\u3044"
    textJapanese: "\u3055\u3042\u624B\u3092\u6574\u3048 \u76EE\u3092\u6F84\u307E\u305B\u3066\u9032\u307F\u306A\u3055\u3044"
    textEnglish: Now, ready your hand, clear your eyes, and move forward.
    textChineseSimplified: "\u6765\u5427\uFF0C\u6574\u7406\u597D\u624B\u724C\uFF0C\u51DD\u795E\u770B\u6E05\u524D\u8DEF\uFF0C\u7EE7\u7EED\u524D\u8FDB\u3002"
    portrait: {fileID: 21300000, guid: 0118ce754b789f04ea8c17acfb78ce10, type: 3}
  - speaker: "\u5929\u4F7F"
    speakerJapanese: "\u5929\u4F7F"
    speakerEnglish: Angel
    speakerChineseSimplified: "\u5929\u4F7F"
    text: "\u79C1\u306F\u305D\u306E\u8ECC\u8DE1\u3092\u898B\u5B88\u308B\u308F"
    textJapanese: "\u79C1\u306F\u305D\u306E\u8ECC\u8DE1\u3092\u898B\u5B88\u308B\u308F"
    textEnglish: I will watch over your journey.
    textChineseSimplified: "\u6211\u4F1A\u5B88\u671B\u4F60\u7684\u65C5\u7A0B\u3002"
    portrait: {fileID: 21300000, guid: 0118ce754b789f04ea8c17acfb78ce10, type: 3}
  defeatLines:
  - speaker: "\u5929\u4F7F"
    speakerJapanese: "\u5929\u4F7F"
    speakerEnglish: Angel
    speakerChineseSimplified: "\u5929\u4F7F"
    text: "\u3084\u3063\u3071\u308A\u6575\u308F\u306A\u304B\u3063\u305F\u306E\u306D"
    textJapanese: "\u3084\u3063\u3071\u308A\u6575\u308F\u306A\u304B\u3063\u305F\u306E\u306D"
    textEnglish: "So, you still couldn\u2019t prevail."
    textChineseSimplified: "\u679C\u7136\u8FD8\u662F\u6CA1\u80FD\u6218\u80DC\u5417\u3002"
    portrait: {fileID: 21300000, guid: 0118ce754b789f04ea8c17acfb78ce10, type: 3}
  - speaker: "\u5929\u4F7F"
    speakerJapanese: "\u5929\u4F7F"
    speakerEnglish: Angel
    speakerChineseSimplified: "\u5929\u4F7F"
    text: "\u3067\u3082\u3053\u308C\u3067\u7D42\u308F\u308A\u3058\u3083\u306A\u3044"
    textJapanese: "\u3067\u3082\u3053\u308C\u3067\u7D42\u308F\u308A\u3058\u3083\u306A\u3044"
    textEnglish: But this is not the end.
    textChineseSimplified: "\u4F46\u8FD9\u8FD8\u4E0D\u662F\u7ED3\u675F\u3002"
    portrait: {fileID: 21300000, guid: 0118ce754b789f04ea8c17acfb78ce10, type: 3}
  - speaker: "\u5929\u4F7F"
    speakerJapanese: "\u5929\u4F7F"
    speakerEnglish: Angel
    speakerChineseSimplified: "\u5929\u4F7F"
    text: "\u7D42\u308F\u308B\u3053\u3068\u306F\u3067\u304D\u306A\u3044\u30FB\u30FB\u30FB"
    textJapanese: "\u7D42\u308F\u308B\u3053\u3068\u306F\u3067\u304D\u306A\u3044\u30FB\u30FB\u30FB"
    textEnglish: It cannot end yet.
    textChineseSimplified: "\u8FD8\u4E0D\u80FD\u5C31\u8FD9\u6837\u7ED3\u675F\u3002"
    portrait: {fileID: 21300000, guid: 0118ce754b789f04ea8c17acfb78ce10, type: 3}
  - speaker: "\u5929\u4F7F"
    speakerJapanese: "\u5929\u4F7F"
    speakerEnglish: Angel
    speakerChineseSimplified: "\u5929\u4F7F"
    text: "\u304C\u3093\u3070\u3063\u3066\u306D"
    textJapanese: "\u304C\u3093\u3070\u3063\u3066\u306D"
    textEnglish: Do your best.
    textChineseSimplified: "\u52A0\u6CB9\u3002"
    portrait: {fileID: 21300000, guid: 0118ce754b789f04ea8c17acfb78ce10, type: 3}
  clearLines:
  - speaker: "\u5929\u4F7F"
    speakerJapanese: "\u5929\u4F7F"
    speakerEnglish: Angel
    speakerChineseSimplified: "\u5929\u4F7F"
    text: "\u3064\u3044\u306B\u3084\u3063\u305F\u306E\u306D"
    textJapanese: "\u3064\u3044\u306B\u3084\u3063\u305F\u306E\u306D"
    textEnglish: You finally did it.
    textChineseSimplified: "\u4F60\u7EC8\u4E8E\u505A\u5230\u4E86\u3002"
    portrait: {fileID: 21300000, guid: 0118ce754b789f04ea8c17acfb78ce10, type: 3}
  - speaker: "\u5929\u4F7F"
    speakerJapanese: "\u5929\u4F7F"
    speakerEnglish: Angel
    speakerChineseSimplified: "\u5929\u4F7F"
    text: "\u3053\u308C\u3067\u3059\u3079\u3066\u5143\u3069\u304A\u308A\u306B\u306A\u308B\u306F\u305A\u30FB\u30FB\u30FB"
    textJapanese: "\u3053\u308C\u3067\u3059\u3079\u3066\u5143\u3069\u304A\u308A\u306B\u306A\u308B\u306F\u305A\u30FB\u30FB\u30FB"
    textEnglish: With this, everything should return to normal.
    textChineseSimplified: "\u8FD9\u6837\u4E00\u6765\uFF0C\u4E00\u5207\u5E94\u8BE5\u90FD\u4F1A\u6062\u590D\u539F\u72B6\u3002"
    portrait: {fileID: 21300000, guid: 0118ce754b789f04ea8c17acfb78ce10, type: 3}
  - speaker: "\u5929\u4F7F"
    speakerJapanese: "\u5929\u4F7F"
    speakerEnglish: Angel
    speakerChineseSimplified: "\u5929\u4F7F"
    text: "\u30FB\u30FB\u30FB"
    textJapanese: "\u30FB\u30FB\u30FB"
    textEnglish: ...
    textChineseSimplified: ...
    portrait: {fileID: 21300000, guid: 0118ce754b789f04ea8c17acfb78ce10, type: 3}
  secretHadesIntroLines:
  - speaker: "\u5929\u4F7F"
    speakerJapanese: "\u5929\u4F7F"
    speakerEnglish: Angel
    speakerChineseSimplified: "\u5929\u4F7F"
    text: "\u6765\u305F\u308F\u30FB\u30FB\u30FB"
    textJapanese: "\u6765\u305F\u308F\u30FB\u30FB\u30FB"
    textEnglish: It has come.
    textChineseSimplified: "\u90A3\u5BB6\u4F19\u6765\u4E86\u3002"
    portrait: {fileID: 21300000, guid: 0118ce754b789f04ea8c17acfb78ce10, type: 3}
  - speaker: "\u5929\u4F7F"
    speakerJapanese: "\u5929\u4F7F"
    speakerEnglish: Angel
    speakerChineseSimplified: "\u5929\u4F7F"
    text: "\u3084\u308B\u3057\u304B\u306A\u3044\u308F\u3088"
    textJapanese: "\u3084\u308B\u3057\u304B\u306A\u3044\u308F\u3088"
    textEnglish: You have no choice but to fight.
    textChineseSimplified: "\u4F60\u53EA\u80FD\u4E0A\u4E86\u3002"
    portrait: {fileID: 21300000, guid: 0118ce754b789f04ea8c17acfb78ce10, type: 3}
  - speaker: "\u5929\u4F7F"
    speakerJapanese: "\u5929\u4F7F"
    speakerEnglish: Angel
    speakerChineseSimplified: "\u5929\u4F7F"
    text: "\u884C\u3063\u3066\u304D\u306A\u3055\u3044"
    textJapanese: "\u884C\u3063\u3066\u304D\u306A\u3055\u3044"
    textEnglish: Go.
    textChineseSimplified: "\u53BB\u5427\u3002"
    portrait: {fileID: 21300000, guid: 0118ce754b789f04ea8c17acfb78ce10, type: 3}
  secretHadesClearLines:
  - speaker: "\u5929\u4F7F"
    speakerJapanese: "\u5929\u4F7F"
    speakerEnglish: Angel
    speakerChineseSimplified: "\u5929\u4F7F"
    text: "\u672C\u5F53\u306B\u3084\u3063\u305F\u306E\u306D"
    textJapanese: "\u672C\u5F53\u306B\u3084\u3063\u305F\u306E\u306D"
    textEnglish: You really did it.
    textChineseSimplified: "\u4F60\u771F\u7684\u505A\u5230\u4E86\u3002"
